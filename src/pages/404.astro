---
import { localePath } from "../i18n/ui.ts";
import Base from "../layouts/Base.astro";
---

<Base lang="en" title="Not found">
  <div class="wrap" style="padding-block: 4rem">
    <h1>Not found</h1>
    <p style="margin-top: 1.5rem">
      This page does not exist. Go to the <a href={localePath("en", "/")}>home page</a>, or <a href={localePath("ja", "/")} lang="ja">日本語のトップページ</a>.
    </p>
  </div>
</Base>
