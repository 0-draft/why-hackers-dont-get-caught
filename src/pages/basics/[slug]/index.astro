---
import { getCollection } from "astro:content";
import Essay from "../../../views/Essay.astro";

export async function getStaticPaths() {
  const entries = await getCollection("basics", (e) => e.id.startsWith("en/") && !e.data.draft);
  return entries.map((entry) => ({ params: { slug: entry.data.basics }, props: { entry } }));
}
const { entry } = Astro.props;
---

<Essay lang="en" entry={entry} />
