---
import { SOURCES } from "../data/sources.ts";
import { localePath } from "../i18n/ui.ts";

interface Props {
  id: string;
}
const { id } = Astro.props;
const s = SOURCES[id];
if (!s) throw new Error(`<Cite id="${id}"> has no entry in src/data/sources/*.json`);
const lang = Astro.currentLocale === "ja" ? "ja" : "en";
const href = Astro.url.pathname.replace(/\/$/, "").endsWith(`/${s.page}`)
  ? `#src-${id}`
  : localePath(lang, `/sources/#src-${id}`);
---

<sup class="cite"><a href={href} title={`${s.publisher}: ${s.title}`}>{s.n}</a></sup>

<style>
  .cite {
    font-size: 0.68em;
    line-height: 0;
    margin-left: 0.1em;
    font-family: var(--mono);
  }
  .cite a {
    text-decoration: none;
    padding: 0 0.15em;
    border: 1px solid var(--rule);
  }
  .cite a:hover {
    border-color: var(--ink);
  }
  .cite + :global(.cite) {
    margin-left: 0.15em;
  }
</style>
