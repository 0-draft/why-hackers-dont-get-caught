---
import { CASES } from "../data/cases.ts";
import { FAILURE_KINDS, LAYERS } from "../data/layers.ts";
import { type Lang, localePath, useT } from "../i18n/ui.ts";

// Every case filed under the layer that gave way first. The tallest column
// answers the question the matrix used to bury: where do the caught get caught?
interface Props {
  lang: Lang;
  /** Home page: cards link to the case page instead of the file below. */
  compact?: boolean;
}
const { lang, compact = false } = Astro.props;
const t = useT(lang);
const cols = FAILURE_KINDS.map((k) => ({ k, cases: CASES.filter((c) => c.failed === k).toReversed() }))
  .filter((c) => c.cases.length > 0)
  .toSorted((a, b) => b.cases.length - a.cases.length);
const max = Math.max(...cols.map((c) => c.cases.length));
---

<div class="cb" data-case-board>
  <p class="cb-total">
    <span class="n">{CASES.length}</span>
    {t("board.total")}
  </p>
  <ol class="cols">
    {
      cols.map(({ k, cases }) => (
        <li class="col" style={`--share:${cases.length / max}`}>
          <header>
            <a
              class="ln"
              href={localePath(lang, k === "people" ? "/cases/#people" : `/layers/${k}/`)}
            >
              {LAYERS[k].name[lang]}
            </a>
            <span class="cnt">
              <span class="cn">{cases.length}</span>
              {t("board.unit")}
            </span>
            <span class="meter" aria-hidden="true" />
            <span class="br">{LAYERS[k].breaks[lang]}</span>
          </header>
          <ul>
            {cases.map((c) => (
              <li>
                <a href={compact ? localePath(lang, `/cases/#${c.id}`) : `#${c.id}`}>
                  <span class="yr">{c.year}</span>
                  <span class="nm">{c.alias?.[lang].split(/[／/]/)[0]?.replace(/[「」"]/g, "").trim() || c.name[lang]}</span>
                  {c.timeline && <span class="sw">{c.timeline.slipWhat[lang]}</span>}
                </a>
              </li>
            ))}
          </ul>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .cb-total {
    margin: 0 0 1rem;
    color: var(--ink-2);
    font-size: var(--step--1);
  }
  .cb-total .n {
    font-family: var(--mono);
    font-weight: 700;
    color: var(--ink);
    font-size: var(--step-1);
  }
  .cols {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 0.75rem;
    align-items: start;
  }
  .col {
    background: var(--sheet);
    border: 1.5px solid var(--ink);
  }
  header {
    padding: 0.7rem 0.8rem 0.6rem;
    border-bottom: 1.5px solid var(--ink);
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    row-gap: 0.35rem;
  }
  .ln {
    grid-column: 1 / -1;
    font-weight: 800;
    font-size: var(--step-0);
    text-decoration: none;
  }
  .ln:hover {
    text-decoration: underline;
  }
  .cnt {
    grid-column: 1 / -1;
    font-size: 0.75rem;
    color: var(--ink-2);
  }
  .cn {
    font-family: var(--mono);
    font-weight: 700;
    font-size: var(--step-2);
    color: var(--leak);
    line-height: 1;
  }
  .meter {
    grid-column: 1 / -1;
    height: 0.5rem;
    background: var(--rule-soft);
    position: relative;
  }
  .meter::after {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: calc(var(--share) * 100%);
    background: var(--leak);
  }
  .br {
    grid-column: 1 / -1;
    font-size: 0.75rem;
    line-height: 1.4;
    color: var(--ink-2);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0.3rem 0;
  }
  ul a {
    display: grid;
    grid-template-columns: 2.6rem minmax(0, 1fr);
    column-gap: 0.4rem;
    padding: 0.35rem 0.8rem;
    text-decoration: none;
    line-height: 1.3;
  }
  ul a:hover,
  ul a:focus-visible {
    background: var(--marker);
    color: var(--marker-ink);
  }
  .yr {
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--ink-2);
    padding-top: 0.1rem;
  }
  ul a:hover .yr {
    color: inherit;
  }
  .nm {
    font-weight: 700;
    font-size: var(--step--1);
    overflow-wrap: anywhere;
  }
  .sw {
    grid-column: 2;
    font-size: 0.75rem;
    color: var(--ink-2);
  }
  ul a:hover .sw {
    color: inherit;
  }
</style>
