---
import { CASES } from "../data/cases.ts";
import { FAILURE_KINDS, LAYERS } from "../data/layers.ts";
import type { Case } from "../data/schema.ts";
import { SOURCES } from "../data/sources.ts";
import { type Lang, localePath, useT } from "../i18n/ui.ts";

// The register: one line per case, newest first. The strip of eight cells runs
// from the person (left) out to the people around them (right): black where the
// person hid, magenta where investigators got through. The slip that gave it
// away is the highlighted phrase. Opening a line shows the account and sources.
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const sep = lang === "ja" ? { list: "、", end: "。" } : { list: ", ", end: ". " };
// Spoken in the strip's own left-to-right order; the failed layer comes last.
const stripLabel = (c: Case) => {
  const relied = FAILURE_KINDS.filter((k) => k !== c.failed && c.used.includes(k)).map((k) => LAYERS[k].name[lang]);
  const head = relied.length ? `${t("cases.used")}: ${relied.join(sep.list)}${sep.end}` : "";
  return `${head}${t("cases.failed")}: ${LAYERS[c.failed].name[lang]}`;
};
---

<ol class="reg" data-case-files>
  {
    CASES.toReversed().map((c) => (
      <li id={c.id}>
        <details>
          <summary>
            <span class="yr">{c.year}</span>
            <span class="who">
              <span class="nm">{c.name[lang]}</span>
              {c.alias && <span class="al">{c.alias[lang]}</span>}
            </span>
            <span
              class="strip"
              role="img"
              aria-label={stripLabel(c)}
            >
              {FAILURE_KINDS.map((k) => (
                <span
                  class:list={["cell", c.failed === k ? "failed" : c.used.includes(k) ? "used" : "none"]}
                  aria-hidden="true"
                >
                  {LAYERS[k].name[lang]}
                </span>
              ))}
            </span>
            <span class="sw">
              {c.timeline && <mark>{c.timeline.slipWhat[lang]}</mark>}
              {c.disputed && <span class="disp">{t("cases.disputed")}</span>}
            </span>
          </summary>
          <div class="acct">
            <dl>
              <dt>{t("cases.mechanism")}</dt>
              <dd class="mech">{c.mechanism[lang]}</dd>
              <dt>{t("cases.background")}</dt>
              <dd>{c.background[lang]}</dd>
              {c.disputed && (
                <>
                  <dt class="dt-disp">{t("cases.disputed")}</dt>
                  <dd>{c.disputed[lang]}</dd>
                </>
              )}
              <dt>{t("cases.outcome")}</dt>
              <dd>{c.outcome[lang]}</dd>
              <dt>{t("cases.sources")}</dt>
              <dd>
                <ul class="cs">
                  {c.sources.map((id) => {
                    const s = SOURCES[id];
                    return s ? (
                      <li>
                        <a
                          href={s.url}
                          rel="noopener noreferrer"
                          lang={/[぀-ヿ一-鿿]/.test(s.title + s.publisher) ? "ja" : undefined}
                        >
                          {s.publisher}: {s.title}
                        </a>
                      </li>
                    ) : null;
                  })}
                </ul>
              </dd>
            </dl>
            <p class="to">
              <a href={localePath(lang, c.failed === "people" ? "/cases/#people" : `/layers/${c.failed}/`)}>
                {LAYERS[c.failed].name[lang]}
              </a>
            </p>
          </div>
        </details>
      </li>
    ))
  }
</ol>

<script>
  // A link to /cases/#id should land on that line already open. Only lines of
  // the register count: #main (the skip link) must not open anything.
  const open = () => {
    let id = location.hash.slice(1);
    try {
      id = decodeURIComponent(id);
    } catch {
      return;
    }
    const li = id ? document.getElementById(id) : null;
    if (li?.parentElement?.matches("[data-case-files]")) li.querySelector(":scope > details")?.setAttribute("open", "");
  };
  open();
  window.addEventListener("hashchange", open);
</script>

<style>
  .reg {
    list-style: none;
    padding: 0;
    margin: 3rem 0 0;
    border-top: 2px solid var(--ink);
  }
  .reg > li {
    border-bottom: 1px solid var(--rule);
    scroll-margin-top: 1.5rem;
  }
  .reg > li:target summary {
    box-shadow: inset 0.35rem 0 0 var(--marker);
    padding-left: 0.8rem;
  }
  summary {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 15rem) minmax(16rem, 26rem) minmax(0, 1fr);
    gap: 0.4rem 1.25rem;
    align-items: center;
    padding: 0.7rem 0;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover .nm {
    text-decoration: underline;
  }
  .yr {
    font-size: var(--step--1);
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
  }
  .nm {
    display: block;
    font-weight: 800;
    line-height: 1.3;
  }
  .al {
    display: block;
    font-size: 0.8rem;
    color: var(--ink-2);
    line-height: 1.35;
  }
  .strip {
    display: grid;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    gap: 2px;
  }
  .cell {
    height: 1.9rem;
    display: grid;
    place-items: center;
    text-align: center;
    font-size: 0.62rem;
    line-height: 1.05;
    padding: 0 1px;
    overflow: hidden;
  }
  .cell.none {
    color: var(--ink-2);
    background: repeating-linear-gradient(135deg, transparent 0 3px, var(--rule-soft) 3px 4px);
  }
  .cell.used {
    background: var(--bar);
    box-shadow: 0 0 0 1px var(--bar-edge);
    color: #fff;
    font-weight: 700;
  }
  .cell.failed {
    background: var(--leak);
    color: var(--sheet);
    font-weight: 800;
    padding-inline: 14%;
    clip-path: polygon(0 0, 100% 0, 100% 38%, 86% 52%, 100% 66%, 100% 100%, 0 100%, 0 66%, 14% 50%, 0 34%);
  }
  .sw {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    align-items: baseline;
    font-weight: 700;
  }
  mark {
    background: linear-gradient(transparent 12%, var(--marker) 12%, var(--marker) 88%, transparent 88%);
    color: var(--marker-ink);
    padding: 0 0.15rem;
  }
  .disp {
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--ink-2);
    text-decoration: underline dotted;
  }
  .acct {
    max-width: var(--measure);
    margin: 0 0 1.25rem calc(2.75rem + 1.25rem);
    font-size: var(--step--1);
    line-height: 1.75;
  }
  .mech {
    font-size: var(--step-0);
  }
  dl {
    margin: 0;
  }
  dt {
    color: var(--ink-2);
    margin-top: 0.8rem;
    font-size: 0.8rem;
  }
  .dt-disp {
    color: var(--ink);
    font-weight: 700;
  }
  dd {
    margin: 0.1rem 0 0;
  }
  .cs {
    padding-left: 1.1rem;
    margin: 0;
  }
  .to {
    margin: 0.9rem 0 0;
    font-weight: 700;
  }
  @media (max-width: 60rem) {
    summary {
      grid-template-columns: 2.75rem minmax(0, 1fr);
    }
    .strip,
    .sw {
      grid-column: 2;
    }
  }
  @media (max-width: 34rem) {
    .acct {
      margin-left: 0;
    }
    .cell {
      font-size: 0.56rem;
    }
  }
</style>
