---
// Illustrative activity log, shaped like the APT28 compile-time findings:
// weekday office hours in UTC+4. The same log is drawn three times, read in
// three clocks; only UTC+4 turns it into an ordinary office week.
interface Props {
  lang: "en" | "ja";
}
const { lang } = Astro.props;
const L = {
  en: {
    title: "The same week of logged activity, read in three clocks",
    days: ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"],
    office: "frame: 08:00–18:00, Mon–Fri",
    active: "active hour",
    note: "Illustrative data, shaped like FireEye's published APT28 compile-time statistics.",
    verdict: {
      0: "starts at 04:00, stops at 14:00",
      4: "an office week",
      8: "starts at noon, runs to 22:00",
    } as Record<number, string>,
  },
  ja: {
    title: "同じ 1 週間の活動ログを、3 つの時計で読む",
    days: ["月", "火", "水", "木", "金", "土", "日"],
    office: "枠: 月〜金の 8〜18 時",
    active: "活動した時間",
    note: "データは説明用。FireEye が公表した APT28 のコンパイル時刻の統計の形に合わせてある。",
    verdict: {
      0: "4 時に始まり 14 時に終わる",
      4: "オフィスの 1 週間",
      8: "正午に始まり 22 時まで",
    } as Record<number, string>,
  },
}[lang];

// Active (weekday, hour) pairs in the actor's local time, UTC+4.
const LOCAL = 4;
const active: [number, number][] = [];
for (let d = 0; d < 5; d++) {
  for (let h = 8; h < 18; h++) active.push([d, h]);
}
active.push([1, 20], [3, 21], [5, 10]);

const OFFSETS = [0, 4, 8];
function shifted(offset: number) {
  const set = new Set<string>();
  for (const [d, h] of active) {
    const t = d * 24 + h + (offset - LOCAL) + 7 * 24;
    set.add(`${Math.floor(t / 24) % 7}-${t % 24}`);
  }
  return set;
}
const cw = 24;
const ch = 14;
const x0 = 64;
const top = 44;
const panelH = 152;
const fmt = (o: number) => (o === 0 ? "UTC" : `UTC+${o}`);
---

<svg class="dg" viewBox={`0 0 680 ${top + 3 * panelH + 40}`} role="img" aria-labelledby={`bclk-t-${lang}`}>
  <title id={`bclk-t-${lang}`}>{L.title}</title>
  {
    [0, 3, 6, 9, 12, 15, 18, 21].map((h) => (
      <text x={x0 + h * cw} y="20" class="mono t-2">
        {String(h).padStart(2, "0")}
      </text>
    ))
  }
  {
    OFFSETS.map((o, pi) => {
      const set = shifted(o);
      const y0 = top + pi * panelH;
      const gy = y0 + 28;
      return (
        <g>
          {o === LOCAL && <rect x="6" y={y0 - 6} width="668" height={panelH - 10} class="ln" fill="none" />}
          <text x="16" y={y0 + 14} class={o === LOCAL ? "t-l" : "b"}>
            {fmt(o)}
          </text>
          <text x={x0 + 70} y={y0 + 14} class={o === LOCAL ? "b" : "t-s t-2"}>
            {L.verdict[o]}
          </text>
          {L.days.map((d, i) => (
            <text x={x0 - 10} y={gy + i * ch + 11} class="t-s" text-anchor="end">
              {d}
            </text>
          ))}
          {Array.from({ length: 7 }, (_, d) =>
            Array.from({ length: 24 }, (_, h) =>
              set.has(`${d}-${h}`) ? (
                <rect x={x0 + h * cw + 1} y={gy + d * ch + 1} width={cw - 2} height={ch - 2} class="fill-ink" opacity="0.55" />
              ) : (
                <rect x={x0 + h * cw + 1} y={gy + d * ch + 1} width={cw - 2} height={ch - 2} class="box-soft" />
              ),
            ),
          )}
          <rect x={x0 + 8 * cw} y={gy - 2} width={10 * cw} height={5 * ch + 4} class="ln dash" fill="none" />
        </g>
      );
    })
  }
  <text x="16" y={top + 3 * panelH + 4} class="t-s b">{L.office}</text>
  <rect x="300" y={top + 3 * panelH - 8} width="14" height="14" class="fill-ink" opacity="0.55"></rect>
  <text x="320" y={top + 3 * panelH + 4} class="t-s t-2">{L.active}</text>
  <text x="16" y={top + 3 * panelH + 26} class="t-s t-2">{L.note}</text>
</svg>
