---
// What a mixer hides (the path inside the pool) and what stays readable
// around it (amounts, times, and where the coins finally land).
interface Props {
  lang: "en" | "ja";
}
const { lang } = Astro.props;

const L = {
  en: {
    label:
      "Three deposits go into a mixer and three withdrawals come out. The mixer hides which deposit became which withdrawal, but a 2.37 BTC deposit at 03:10 and a 2.35 BTC withdrawal at 03:52 still line up, and that withdrawal goes to an exchange that knows the account holder.",
    in: "in",
    out: "out",
    mixer: "mixer pool",
    logs: "a custodial operator logs this path",
    inferred: "similar size, minutes apart: linked anyway",
    exchange: "Exchange",
    holder: "account holder",
    k1: "hidden: which deposit became which withdrawal",
    k2: "readable: amounts, times, the exit",
    k3: "names someone: the exchange's record",
  },
  ja: {
    label:
      "3 件の入金がミキサーに入り、3 件の出金が出てくる。どの入金がどの出金になったかはミキサーが隠す。しかし 03:10 の 2.37 BTC の入金と 03:52 の 2.35 BTC の出金は対応が付き、その出金は口座の持ち主を知る取引所に入る。",
    in: "入金",
    out: "出金",
    mixer: "ミキサーのプール",
    logs: "管理型なら運営者がこの経路を記録する",
    inferred: "金額が近く時刻も近い: 結局つながる",
    exchange: "取引所",
    holder: "口座の持ち主",
    k1: "隠れる: どの入金がどの出金になったか",
    k2: "読める: 金額・時刻・出口",
    k3: "人を指す: 取引所の記録",
  },
}[lang];

const ins = [
  { y: 40, amt: "1.00", t: "02:58" },
  { y: 100, amt: "0.50", t: "03:02" },
  { y: 160, amt: "2.37", t: "03:10" },
];
const outs = [
  { y: 40, amt: "0.99", t: "03:31" },
  { y: 100, amt: "0.49", t: "04:15" },
  { y: 160, amt: "2.35", t: "03:52" },
];
const mid = `mm-arr-${lang}`;
---

<svg class="dg" viewBox="0 0 680 380" role="img" aria-label={L.label}>
  <defs>
    <marker id={mid} viewBox="0 0 10 10" refX="10" refY="5" markerWidth="7" markerHeight="7" orient="auto">
      <path d="M0,0 L10,5 L0,10 z" class="fill-ink"></path>
    </marker>
  </defs>

  <text class="b" x="325" y="28" text-anchor="middle">{L.mixer}</text>
  <rect class="fill-bar" x="250" y="40" width="150" height="166"></rect>
  <text class="t-s t-2" x="325" y="226" text-anchor="middle">{L.logs}</text>

  {
    ins.map((d) => (
      <g>
        <rect class="fill-hl" x="20" y={d.y} width="150" height="46"></rect>
        <text class="mono t-on-hl" x="32" y={d.y + 19}>
          {L.in} {d.amt} BTC
        </text>
        <text class="mono t-on-hl" x="32" y={d.y + 36}>
          {d.t}
        </text>
        <line class="ln-1" x1="170" y1={d.y + 23} x2="250" y2={d.y + 23} marker-end={`url(#${mid})`}></line>
      </g>
    ))
  }
  {
    outs.map((d) => (
      <g>
        <line class="ln-1" x1="400" y1={d.y + 23} x2="490" y2={d.y + 23} marker-end={`url(#${mid})`}></line>
        <rect class="fill-hl" x="490" y={d.y} width="150" height="46"></rect>
        <text class="mono t-on-hl" x="502" y={d.y + 19}>
          {L.out} {d.amt} BTC
        </text>
        <text class="mono t-on-hl" x="502" y={d.y + 36}>
          {d.t}
        </text>
      </g>
    ))
  }

  <!-- the link the mixer did not hide -->
  <polyline class="ln dash" points="95,206 95,250 545,250 545,206"></polyline>
  <text class="t-s" x="320" y="270" text-anchor="middle">{L.inferred}</text>

  <!-- the exit -->
  <line class="ln-1" x1="615" y1="206" x2="615" y2="300" marker-end={`url(#${mid})`}></line>
  <rect class="box" x="490" y="300" width="170" height="60"></rect>
  <text class="b" x="502" y="324">{L.exchange}</text>
  <text class="t-leak" x="502" y="346">{L.holder}</text>

  <!-- key -->
  <rect class="fill-bar" x="20" y="302" width="14" height="14"></rect>
  <text class="t-s" x="42" y="314">{L.k1}</text>
  <rect class="fill-hl" x="20" y="326" width="14" height="14"></rect>
  <text class="t-s" x="42" y="338">{L.k2}</text>
  <rect class="fill-leak" x="20" y="350" width="14" height="14"></rect>
  <text class="t-s" x="42" y="362">{L.k3}</text>
</svg>
