---
// The Diamond Model with a worked pivot sequence, plus a toggle that marks
// which vertices an adversary can fake or borrow.
interface Props {
  lang: "en" | "ja";
}
const { lang } = Astro.props;

const L = {
  en: {
    label:
      "The Diamond Model: adversary, capability, infrastructure and victim. Analysts start from the victim's logs, pivot to the command server, from there to a second sample, and from the code to a group they already track. The adversary at the top is an assessment, never a reading.",
    toggle: "Show what can be faked",
    note: "Capability evidence (compiler traces, language strings, timestamps) can be planted. Infrastructure can be borrowed from another group. Both feed the pivots that end at the adversary.",
    adversary: "Adversary",
    infra: "Infrastructure",
    cap: "Capability",
    victim: "Victim",
    c2: "C2 server",
    fam: "backdoor family",
    capSub: "compiler, strings, code",
    p1: ["1 · victim's logs", "show the C2"],
    p2: "2 · same C2 served another sample",
    p3: ["3 · code overlaps", "a tracked group"],
    p4: "4 · assessed, not proven",
    borrow: "can be borrowed",
    plant: "can be planted",
  },
  ja: {
    label:
      "ダイヤモンドモデル。攻撃者・能力・インフラ・被害者の 4 点。分析者は被害者のログから C2 サーバへ、そこから別の検体へ、コードから既に追跡している集団へとたどる。頂点の攻撃者は推定であって、読み取った事実ではない。",
    toggle: "偽装できるところを表示",
    note: "能力側の証拠 (コンパイラの痕跡・言語の文字列・タイムスタンプ) は仕込める。インフラは他の集団から借りられる。どちらも、最後に攻撃者へたどり着くピボットの材料になる。",
    adversary: "攻撃者",
    infra: "インフラ",
    cap: "能力",
    victim: "被害者",
    c2: "C2 サーバ",
    fam: "バックドアの系統",
    capSub: "コンパイラ・文字列・コード",
    p1: ["1 · 被害者のログに", "C2 への通信"],
    p2: "2 · 同じ C2 が別の検体も配布",
    p3: ["3 · 追跡中の集団と", "コードが重なる"],
    p4: "4 · 推定であって証明ではない",
    borrow: "借りられる",
    plant: "仕込める",
  },
}[lang];
---

<div class="ad" data-ad data-planted="true">
  <div class="tools">
    <button type="button" aria-pressed="true" data-toggle>{L.toggle}</button>
  </div>
  <svg class="dg" viewBox="0 0 680 440" role="img" aria-label={L.label}>
    <!-- edges -->
    <line class="ln" x1="262" y1="84" x2="150" y2="180"></line>
    <line class="ln" x1="418" y1="84" x2="530" y2="180"></line>
    <line class="ln" x1="220" y1="220" x2="460" y2="220"></line>
    <line class="ln" x1="150" y1="260" x2="262" y2="356"></line>
    <line class="ln" x1="470" y1="260" x2="418" y2="356"></line>

    <!-- adversary: unknown until assessed -->
    <rect class="box" x="250" y="20" width="180" height="64"></rect>
    <text class="b" x="262" y="44">{L.adversary}</text>
    <rect class="fill-bar" x="262" y="56" width="110" height="14"></rect>
    <text class="t-s" x="340" y="106" text-anchor="middle">{L.p4}</text>

    <!-- infrastructure -->
    <rect class="box" x="20" y="180" width="200" height="80"></rect>
    <text class="b" x="32" y="203">{L.infra}</text>
    <rect class="fill-hl" x="32" y="213" width="120" height="22"></rect>
    <text class="mono t-on-hl" x="40" y="228">203.0.113.7</text>
    <text class="t-s t-2" x="32" y="251">{L.c2}</text>

    <!-- capability -->
    <rect class="box" x="460" y="180" width="200" height="80"></rect>
    <text class="b" x="472" y="203">{L.cap}</text>
    <rect class="fill-hl" x="472" y="213" width="150" height="22"></rect>
    <text class="t-on-hl t-s" x="480" y="228">{L.fam}</text>
    <text class="t-s t-2" x="472" y="251">{L.capSub}</text>

    <!-- victim -->
    <rect class="box" x="250" y="356" width="180" height="64"></rect>
    <text class="b" x="262" y="380">{L.victim}</text>
    <rect class="fill-hl" x="262" y="390" width="140" height="20"></rect>
    <text class="mono t-on-hl" x="268" y="404">mail.example.org</text>

    <!-- pivots -->
    <text class="t-s" x="205" y="316" text-anchor="end">{L.p1[0]}</text>
    <text class="t-s" x="205" y="332" text-anchor="end">{L.p1[1]}</text>
    <text class="t-s" x="340" y="210" text-anchor="middle">{L.p2}</text>
    <text class="t-s" x="505" y="112">{L.p3[0]}</text>
    <text class="t-s" x="505" y="128">{L.p3[1]}</text>

    <!-- what an adversary can fake -->
    <g class="pl">
      <rect class="ln-1 dash" x="10" y="170" width="220" height="124"></rect>
      <text class="t-s b" x="22" y="284">{L.borrow}</text>
      <rect class="ln-1 dash" x="450" y="170" width="220" height="124"></rect>
      <text class="t-s b" x="658" y="284" text-anchor="end">{L.plant}</text>
    </g>
  </svg>
  <p class="note pl-note">{L.note}</p>
</div>

<style>
  .tools {
    margin-bottom: 0.9rem;
  }
  .tools button {
    font: inherit;
    font-size: var(--step--1);
    padding: 0.3rem 0.7rem;
    background: var(--sheet);
    color: var(--ink);
    border: 1.5px solid var(--ink);
    cursor: pointer;
  }
  .tools button[aria-pressed="true"] {
    background: var(--ink);
    color: var(--sheet);
  }
  .note {
    margin: 0.9rem 0 0;
    font-size: var(--step--1);
    max-width: 68ch;
  }
  .ad[data-planted="false"] .pl,
  .ad[data-planted="false"] .pl-note {
    visibility: hidden;
  }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>("[data-ad]")) {
    const b = root.querySelector<HTMLButtonElement>("[data-toggle]")!;
    const set = (on: boolean) => {
      root.dataset.planted = String(on);
      b.setAttribute("aria-pressed", String(on));
    };
    b.addEventListener("click", () => set(root.dataset.planted !== "true"));
    set(false);
  }
</script>
