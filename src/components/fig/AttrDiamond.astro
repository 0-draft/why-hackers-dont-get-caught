---
// The Diamond Model with a worked example. Pivots are numbered on the edges
// and repeated below as a linear chain, because analysis is a sequence.
// Dashed outlines mark the vertices an adversary can plant or borrow.
interface Props {
  lang: "en" | "ja";
}
const { lang } = Astro.props;

const L = {
  en: {
    label:
      "The Diamond Model: every intrusion links an adversary, a capability, infrastructure and a victim. Analysts go from the victim's logs to the C2 server, from the server to a second sample, from the code to a group they already track, and from there to an assessed adversary. The capability can be planted and the infrastructure borrowed.",
    def: "Diamond Model: every intrusion links four things. Knowing one helps find the others.",
    adversary: "Adversary",
    infra: "Infrastructure",
    cap: "Capability",
    victim: "Victim",
    c2: "C2 server",
    fam: "backdoor family",
    capSub: "compiler, strings, code",
    assessed: "assessed, not proven",
    borrow: "can be borrowed",
    plant: "can be planted",
    chainTitle: "The pivots in order",
    chain: ["victim's logs", "C2 server", "second sample", "tracked group", "adversary?"],
  },
  ja: {
    label:
      "ダイヤモンドモデル。どの侵入も攻撃者・能力・インフラ・被害者を結ぶ。分析者は被害者のログから C2 サーバへ、サーバから別の検体へ、コードから既に追跡している集団へ、そこから推定の攻撃者へと進む。能力は仕込めるし、インフラは借りられる。",
    def: "ダイヤモンドモデル: どの侵入も 4 つの要素を結ぶ。1 つわかれば残りを探せる。",
    adversary: "攻撃者",
    infra: "インフラ",
    cap: "能力",
    victim: "被害者",
    c2: "C2 サーバ",
    fam: "バックドアの系統",
    capSub: "コンパイラ・文字列・コード",
    assessed: "推定であって証明ではない",
    borrow: "借りられる",
    plant: "仕込める",
    chainTitle: "ピボットの順序",
    chain: ["被害者のログ", "C2 サーバ", "別の検体", "追跡中の集団", "攻撃者 (推定)"],
  },
}[lang];

const pivots = [
  { n: 1, x: 206, y: 338 },
  { n: 2, x: 340, y: 250 },
  { n: 3, x: 474, y: 162 },
  { n: 4, x: 230, y: 82 },
];
const boxX = [10, 147, 284, 421, 558];
const mid = `ad-arr-${lang}`;
---

<svg class="dg" viewBox="0 0 680 548" role="img" aria-label={L.label}>
  <defs>
    <marker id={mid} viewBox="0 0 10 10" refX="10" refY="5" markerWidth="7" markerHeight="7" orient="auto">
      <path d="M0,0 L10,5 L0,10 z" class="fill-ink"></path>
    </marker>
  </defs>

  <text class="t-s b" x="10" y="18">{L.def}</text>

  <!-- what an adversary can fake -->
  <rect class="ln-1 dash" x="10" y="200" width="220" height="124"></rect>
  <text class="t-s b" x="22" y="314">{L.borrow}</text>
  <rect class="ln-1 dash" x="450" y="200" width="220" height="124"></rect>
  <text class="t-s b" x="658" y="314" text-anchor="end">{L.plant}</text>

  <!-- edges -->
  <line class="ln" x1="262" y1="114" x2="150" y2="210"></line>
  <line class="ln" x1="418" y1="114" x2="530" y2="210"></line>
  <line class="ln" x1="220" y1="250" x2="460" y2="250"></line>
  <line class="ln" x1="150" y1="290" x2="262" y2="386"></line>
  <line class="ln" x1="470" y1="290" x2="418" y2="386"></line>

  <!-- adversary: unknown until assessed -->
  <rect class="box" x="250" y="50" width="180" height="64"></rect>
  <text class="b" x="262" y="74">{L.adversary}</text>
  <rect class="fill-bar" x="262" y="86" width="110" height="14"></rect>
  <text class="t-s" x="340" y="136" text-anchor="middle">{L.assessed}</text>

  <!-- infrastructure -->
  <rect class="box" x="20" y="210" width="200" height="80"></rect>
  <text class="b" x="32" y="233">{L.infra}</text>
  <rect class="fill-hl" x="32" y="243" width="120" height="22"></rect>
  <text class="mono t-on-hl" x="40" y="258">203.0.113.7</text>
  <text class="t-s t-2" x="32" y="281">{L.c2}</text>

  <!-- capability -->
  <rect class="box" x="460" y="210" width="200" height="80"></rect>
  <text class="b" x="472" y="233">{L.cap}</text>
  <rect class="fill-hl" x="472" y="243" width="150" height="22"></rect>
  <text class="t-on-hl t-s" x="480" y="258">{L.fam}</text>
  <text class="t-s t-2" x="472" y="281">{L.capSub}</text>

  <!-- victim -->
  <rect class="box" x="250" y="386" width="180" height="64"></rect>
  <text class="b" x="262" y="410">{L.victim}</text>
  <rect class="fill-hl" x="262" y="420" width="140" height="20"></rect>
  <text class="mono t-on-hl" x="268" y="434">mail.example.org</text>

  <!-- pivot numbers on the diamond -->
  {
    pivots.map((p) => (
      <g>
        <circle class="fill-paper" cx={p.x} cy={p.y} r="11"></circle>
        <circle class="ln-1" cx={p.x} cy={p.y} r="11"></circle>
        <text class="t-s b" x={p.x} y={p.y + 4} text-anchor="middle">
          {p.n}
        </text>
      </g>
    ))
  }

  <!-- the same pivots as a chain -->
  <text class="b" x="10" y="476">{L.chainTitle}</text>
  {
    boxX.map((x, i) => (
      <g>
        <rect class={i === 4 ? "ln-1 dash" : "box"} x={x} y="490" width="112" height="44"></rect>
        <text class="t-s" x={x + 56} y="516" text-anchor="middle">
          {L.chain[i]}
        </text>
        {i < 4 && (
          <line class="ln-1" x1={x + 112} y1="512" x2={x + 137} y2="512" marker-end={`url(#${mid})`}></line>
        )}
        {i < 4 && (
          <text class="t-s b" x={x + 124.5} y="503" text-anchor="middle">
            {i + 1}
          </text>
        )}
      </g>
    ))
  }
</svg>
