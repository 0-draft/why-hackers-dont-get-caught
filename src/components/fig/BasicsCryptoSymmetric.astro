---
// Symmetric encryption: one key locks, the same key unlocks. The path sees
// only ciphertext; the open question is how the key got to both ends.
interface Props {
  lang: "en" | "ja";
}
const { lang } = Astro.props;

const L = {
  en: {
    alice: "Browser",
    bob: "forum.example",
    msg: "anon_4471: hi",
    enc: "encrypt",
    dec: "decrypt",
    key: "with key K",
    cipher: "7f3a 91c0 e2…",
    path: "anyone on the path sees only this",
    shared: "the same key K at both ends, agreed beforehand",
  },
  ja: {
    alice: "ブラウザ",
    bob: "forum.example",
    msg: "anon_4471: hi",
    enc: "暗号化",
    dec: "復号",
    key: "鍵 K で",
    cipher: "7f3a 91c0 e2…",
    path: "経路上の誰もが見るのはこれだけ",
    shared: "両端に同じ鍵 K。事前に共有しておく",
  },
}[lang];

const mk = `bcs-arr-${lang}`;
// x, width of the five boxes in the row
const bx = [
  [12, 130],
  [166, 96],
  [290, 100],
  [418, 96],
  [542, 130],
] as const;
const keyX = (i: 1 | 3) => bx[i][0] + (bx[i][1] - 60) / 2;
const y = 70;
const h = 60;
---

<svg class="dg" viewBox="0 0 680 230" role="img" aria-label={`${L.alice} → ${L.enc} → ${L.cipher} → ${L.dec} → ${L.bob}. ${L.shared}`}>
  <defs>
    <marker id={mk} viewBox="0 0 10 10" refX="10" refY="5" markerWidth="7" markerHeight="7" orient="auto">
      <path d="M0,0 L10,5 L0,10 z" class="fill-ink"></path>
    </marker>
  </defs>

  <!-- observer on the wire -->
  <text x="340" y="30" text-anchor="middle" class="t-s t-2">{L.path}</text>
  <line class="ln-1 dash" x1="340" y1="40" x2="340" y2={y} />

  <!-- row -->
  <rect class="box" x={bx[0][0]} y={y} width={bx[0][1]} height={h} />
  <text x={bx[0][0] + 14} y={y + 22} class="b">{L.alice}</text>
  <rect class="fill-hl" x={bx[0][0] + 12} y={y + 32} width={bx[0][1] - 24} height="20" />
  <text x={bx[0][0] + 16} y={y + 46} class="t-on-hl mono">{L.msg}</text>

  <rect class="box" x={bx[1][0]} y={y} width={bx[1][1]} height={h} />
  <text x={bx[1][0] + bx[1][1] / 2} y={y + 26} text-anchor="middle" class="b">{L.enc}</text>
  <text x={bx[1][0] + bx[1][1] / 2} y={y + 46} text-anchor="middle" class="t-s">{L.key}</text>

  <rect class="fill-bar" x={bx[2][0]} y={y} width={bx[2][1]} height={h} />
  <text x={bx[2][0] + bx[2][1] / 2} y={y + 35} text-anchor="middle" class="mono t-on-ink">{L.cipher}</text>

  <rect class="box" x={bx[3][0]} y={y} width={bx[3][1]} height={h} />
  <text x={bx[3][0] + bx[3][1] / 2} y={y + 26} text-anchor="middle" class="b">{L.dec}</text>
  <text x={bx[3][0] + bx[3][1] / 2} y={y + 46} text-anchor="middle" class="t-s">{L.key}</text>

  <rect class="box" x={bx[4][0]} y={y} width={bx[4][1]} height={h} />
  <text x={bx[4][0] + 14} y={y + 22} class="b">{L.bob}</text>
  <rect class="fill-hl" x={bx[4][0] + 12} y={y + 32} width={bx[4][1] - 24} height="20" />
  <text x={bx[4][0] + 16} y={y + 46} class="t-on-hl mono">{L.msg}</text>

  {
    [0, 1, 2, 3].map((i) => (
      <line
        class="ln"
        x1={bx[i]![0] + bx[i]![1]}
        y1={y + h / 2}
        x2={bx[i + 1]![0]}
        y2={y + h / 2}
        marker-end={`url(#${mk})`}
      />
    ))
  }

  <!-- the key, held at both ends -->
  {
    [1, 3].map((i) => (
      <g>
        <line class="ln-1" x1={bx[i]![0] + bx[i]![1] / 2} y1={y + h} x2={bx[i]![0] + bx[i]![1] / 2} y2="158" />
        <rect class="fill-bar" x={bx[i]![0] + (bx[i]![1] - 60) / 2} y="158" width="60" height="28" />
        <text x={bx[i]![0] + bx[i]![1] / 2} y="177" text-anchor="middle" class="b t-on-ink">K</text>
      </g>
    ))
  }
  <line class="ln-1 dash" x1={keyX(1) + 60} y1="172" x2={keyX(3)} y2="172" />
  <text x="344" y="214" text-anchor="middle" class="t-s">{L.shared}</text>
</svg>
