---
// Interactive: the investigator's chain from one log line to a name. Each step
// shows the record in hand, who holds it, and where the chain can break.
interface Props {
  lang: "en" | "ja";
}
const { lang } = Astro.props;

interface Step {
  holder: string;
  rec: string[];
  leak?: boolean;
  breaks: string[]; // lines starting with two spaces continue the previous bullet
  note: string;
}

const L = {
  en: {
    controls: "Follow the chain",
    nodes: ["Victim's log", "Who owns it", "Legal request", "Subscriber record", "Name, address"],
    recTitle: "The record at this step",
    heldBy: "Held by",
    breakTitle: "Where the chain can break here",
  },
  ja: {
    controls: "鎖を順にたどる",
    nodes: ["被害側のログ", "アドレスの持ち主", "法的な照会", "契約者の記録", "氏名と住所"],
    recTitle: "この段階で手にある記録",
    heldBy: "持っている者",
    breakTitle: "ここで鎖が切れるとき",
  },
}[lang];

const steps: Step[] =
  lang === "en"
    ? [
        {
          holder: "the victim (a web server)",
          rec: ["2026-03-14T03:14:07Z 198.51.100.23:51022", "POST /login 200 (account: anon_4471)"],
          breaks: [
            "no log kept, or already overwritten",
            "clock wrong, or time zone unknown",
            "no source port logged (shared NAT)",
          ],
          note: "It starts with one line written by the system that was attacked: an address, a port and a time. On its own it names nobody.",
        },
        {
          holder: "a regional internet registry (public)",
          rec: [
            "inetnum:  198.51.100.0 - 198.51.100.255",
            "netname:  EXAMPLENET-BB",
            "descr:    ExampleNet broadband customers",
            "country:  JP",
          ],
          breaks: [
            "the address is a VPN or a cloud server:",
            "  start again at that company",
            "the address is a Tor exit relay:",
            "  no record links it to a user",
          ],
          note: "A public registry lookup says which network the address belongs to. Here it is a broadband provider, so the next question goes to that provider. Anyone can do this step.",
        },
        {
          holder: "the investigator, sent to the ISP",
          rec: [
            "To: ExampleNet, legal compliance",
            "1. Preserve records for 198.51.100.23",
            "2. Identify the subscriber using",
            "   198.51.100.23 port 51022",
            "   at 2026-03-14 03:14:07 UTC",
          ],
          breaks: [
            "the ISP is in another country:",
            "  a cross-border request, often months",
            "the logs expire while the paperwork",
            "  is prepared",
          ],
          note: "The provider will not hand over customer data on request. The investigator first asks it to preserve the records, then sends the legal order that the law requires for subscriber information.",
        },
        {
          holder: "the ISP",
          rec: [
            "line 7781",
            "held 2026-03-13T22:05:12Z - 2026-03-14T09:40:31Z",
            "address 198.51.100.23 (no NAT on this line)",
          ],
          breaks: [
            "the retention period is already over",
            "shared NAT with no port records:",
            "  many customers match",
            "the contract was in a false name",
          ],
          note: "The provider looks up who held that address and port at that second, using its assignment and NAT records. This works only if the records still exist and the time in the request is right.",
        },
        {
          holder: "the ISP's customer file",
          rec: ["account holder: Taro Yamada", "service address: [street, city]", "phone: [number]"],
          leak: true,
          breaks: [
            "the account holder is not always the",
            "  person at the keyboard: family,",
            "  guests, open Wi-Fi, a hijacked router",
          ],
          note: "The chain ends at a line, not at a person. Showing who was at the keyboard takes more: a search, the device itself, other accounts used from the same line.",
        },
      ]
    : [
        {
          holder: "被害者 (ウェブサーバー)",
          rec: ["2026-03-14T03:14:07Z 198.51.100.23:51022", "POST /login 200 (account: anon_4471)"],
          breaks: [
            "ログを取っていない、上書きされた",
            "時計がずれている、時間帯が不明",
            "送信元ポートがない (共用 NAT)",
          ],
          note: "出発点は、攻撃されたシステムが書いた 1 行だ。アドレス、ポート、時刻。これだけでは誰の名前も出てこない。",
        },
        {
          holder: "地域インターネットレジストリ (公開)",
          rec: [
            "inetnum:  198.51.100.0 - 198.51.100.255",
            "netname:  EXAMPLENET-BB",
            "descr:    ExampleNet broadband customers",
            "country:  JP",
          ],
          breaks: [
            "アドレスが VPN やクラウドのもの:",
            "  その会社で最初からやり直し",
            "アドレスが Tor の出口リレー:",
            "  利用者に結びつく記録がない",
          ],
          note: "公開のレジストリを引くと、そのアドレスがどのネットワークのものかがわかる。ここでは家庭向け回線の ISP なので、次の問い合わせ先はその ISP になる。この段階は誰でもできる。",
        },
        {
          holder: "捜査機関から ISP へ",
          rec: [
            "To: ExampleNet, legal compliance",
            "1. Preserve records for 198.51.100.23",
            "2. Identify the subscriber using",
            "   198.51.100.23 port 51022",
            "   at 2026-03-14 03:14:07 UTC",
          ],
          breaks: ["ISP が外国にある:", "  国をまたぐ依頼で、数か月かかることも", "書類を整えるあいだにログが消える"],
          note: "事業者は頼まれただけでは契約者の情報を出さない。捜査機関はまず記録の保全を求め、そのうえで契約者情報に必要な法的手続きの書面を送る。",
        },
        {
          holder: "ISP",
          rec: [
            "line 7781",
            "held 2026-03-13T22:05:12Z - 2026-03-14T09:40:31Z",
            "address 198.51.100.23 (no NAT on this line)",
          ],
          breaks: [
            "保存期間がもう過ぎている",
            "共用 NAT でポートの記録がない:",
            "  当てはまる契約者が大勢いる",
            "契約が偽名で結ばれていた",
          ],
          note: "ISP は割り当て記録と NAT の記録を使い、その秒にそのアドレスとポートを持っていたのが誰かを調べる。記録がまだ残っていて、照会の時刻が正しいときにだけ成り立つ。",
        },
        {
          holder: "ISP の顧客台帳",
          rec: ["account holder: Taro Yamada", "service address: [street, city]", "phone: [number]"],
          leak: true,
          breaks: [
            "契約者がキーボードの前の人とは限らない:",
            "  家族、来客、開放された Wi-Fi、",
            "  乗っ取られたルーター",
          ],
          note: "鎖の終点は回線であって、人ではない。誰がキーボードの前にいたかを示すには、捜索、端末そのもの、同じ回線から使われた別のアカウントといった追加の証拠がいる。",
        },
      ];

const nodeX = [20, 200, 380, 560, 740];
const nodeW = 140;
---

<div class="brc" data-brc data-notes={JSON.stringify(steps.map((s) => s.note))}>
  <div class="brc-steps" role="group" aria-label={L.controls}>
    {
      steps.map((_, i) => (
        <button type="button" class="brc-btn" aria-pressed={i === 0 ? "true" : "false"}>
          <span class="brc-n">{i + 1}</span> {L.nodes[i]}
        </button>
      ))
    }
  </div>
  <svg class="dg" viewBox="0 0 900 290" role="img" aria-labelledby="brc-note">
    {
      L.nodes.map((n, i) => (
        <g>
          <rect class={i === 4 ? "stroke-leak" : "box"} x={nodeX[i]!} y="16" width={nodeW} height="44" />
          <text x={nodeX[i]! + nodeW / 2} y="43" text-anchor="middle" class:list={["b t-s", i === 4 && "t-leak"]}>
            {n}
          </text>
          {i < 4 && <line class="ln" x1={nodeX[i]! + nodeW} y1="38" x2={nodeX[i + 1]! - 8} y2="38" />}
          {i < 4 && (
            <polygon
              class="fill-ink"
              points={`${nodeX[i + 1]!},38 ${nodeX[i + 1]! - 9},34 ${nodeX[i + 1]! - 9},42`}
            />
          )}
        </g>
      ))
    }
    <line class="ln-1 soft" x1="20" y1="96" x2="880" y2="96"></line>
    {
      steps.map((s, i) => {
        return (
          <g data-step={i} data-off={i !== 0 ? "" : undefined}>
            <rect class="fill-hl" x={nodeX[i]!} y="66" width={nodeW} height="8" />
            <text x="20" y="126" class="b t-s">
              {L.recTitle}
            </text>
            <text x="20" y="146" class="t-s t-2">
              {L.heldBy}: {s.holder}
            </text>
            <rect
              class={s.leak ? "stroke-leak" : "fill-hl"}
              x="20"
              y="158"
              width="500"
              height={24 + s.rec.length * 20}
            />
            {s.rec.map((t, j) => (
              <text x="34" y={180 + j * 20} class:list={["mono", s.leak ? "t-leak" : "t-on-hl"]}>
                {t}
              </text>
            ))}
            <text x="560" y="126" class="b t-s">
              {L.breakTitle}
            </text>
            {s.breaks.map((t, j) => {
              const cont = t.startsWith("  ");
              return (
                <g>
                  {!cont && <rect class="fill-bar" x="560" y={152 + j * 20} width="8" height="8" />}
                  <text x="576" y={160 + j * 20} class="t-s">
                    {t.trim()}
                  </text>
                </g>
              );
            })}
          </g>
        );
      })
    }
  </svg>
  <p class="brc-note" id="brc-note" aria-live="polite">{steps[0]!.note}</p>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>("[data-brc]")) {
    const btns = [...root.querySelectorAll<HTMLButtonElement>(".brc-btn")];
    const groups = [...root.querySelectorAll<SVGGElement>("[data-step]")];
    const note = root.querySelector<HTMLElement>(".brc-note")!;
    const notes: string[] = JSON.parse(root.dataset.notes ?? "[]");
    const show = (i: number) => {
      btns.forEach((b, j) => b.setAttribute("aria-pressed", String(i === j)));
      groups.forEach((g, j) => {
        if (i === j) g.removeAttribute("data-off");
        else g.setAttribute("data-off", "");
      });
      note.textContent = notes[i] ?? "";
    };
    btns.forEach((b, i) => {
      b.addEventListener("click", () => show(i));
      b.addEventListener("keydown", (e) => {
        const d = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0;
        if (!d) return;
        e.preventDefault();
        const n = (i + d + btns.length) % btns.length;
        show(n);
        btns[n]!.focus();
      });
    });
  }
</script>

<style>
  .brc-steps {
    display: flex;
    flex-wrap: wrap;
    border: 1.5px solid var(--ink);
    margin-bottom: 1rem;
    width: max-content;
    max-width: 100%;
  }
  .brc-btn {
    font: inherit;
    font-weight: 700;
    font-size: var(--step--1);
    background: transparent;
    color: var(--ink);
    border: 0;
    border-right: 1px solid var(--rule);
    padding: 0.45rem 0.85rem;
    cursor: pointer;
  }
  .brc-btn:last-child {
    border-right: 0;
  }
  .brc-btn[aria-pressed="true"] {
    background: var(--ink);
    color: var(--sheet);
  }
  .brc-n {
    font-family: var(--mono);
    font-weight: 400;
    margin-right: 0.2rem;
  }
  .brc svg {
    min-width: 640px;
  }
  .brc [data-off] {
    display: none;
  }
  .brc-note {
    margin: 0.75rem 0 0;
    font-size: var(--step--1);
    max-width: 68ch;
    min-height: 4.8em;
  }
</style>
