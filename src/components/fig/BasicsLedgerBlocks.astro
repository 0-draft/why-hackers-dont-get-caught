---
// Interactive: a transaction waits, is included in a block, and gets buried
// under later blocks. Each block points at the one before it by hash.
interface Props {
  lang: "en" | "ja";
}
const { lang } = Astro.props;

const L = {
  en: {
    group: "Confirmation steps",
    steps: ["Waiting", "In a block", "3 confirmations", "6 confirmations", "Try to edit it"],
    block: "block",
    prev: "prev",
    yours: "your tx",
    others: "other txs",
    hash: "hash",
    edited: "edited",
    broken: "Link broken",
    pool: "Broadcast, waiting to be included",
    conf: "Confirmations",
    back: "each block holds the hash of the one before it",
    say: [
      "The transaction has been broadcast and nodes hold it, but it is in no block yet. It can still be replaced or dropped.",
      "A miner includes it in block 870,000. That is one confirmation. The block's header commits to its contents and to the hash of block 869,999.",
      "Two more blocks are built on top. Changing block 870,000 now would change its hash, break the pointer from 870,001, and require redoing the work for every block after it.",
      "With six blocks on top, replacing it means out-computing the rest of the network for six blocks and more. For an attacker with less than half the computing power, the white paper shows the odds fall exponentially with every block. How many confirmations to wait for is each recipient's choice.",
      "Now change one amount in block 870,000. Its hash changes from 3e1a… to c90d…, but block 870,001 still says prev: 3e1a…, so every node sees the chain break there. To hide the edit, the attacker would have to redo block 870,000 and all five blocks after it, faster than the rest of the network keeps adding new ones.",
    ],
  },
  ja: {
    group: "承認の段階",
    steps: ["待機中", "ブロックに入る", "承認 3", "承認 6", "書き換えてみる"],
    block: "ブロック",
    prev: "前",
    yours: "あなたの取引",
    others: "ほかの取引",
    hash: "ハッシュ",
    edited: "書き換え",
    broken: "参照が切れた",
    pool: "送信済み。ブロックに入るのを待っている",
    conf: "承認数",
    back: "各ブロックは直前のブロックのハッシュを持つ",
    say: [
      "取引はネットワークに送られ、ノードが保持しているが、まだどのブロックにも入っていない。差し替えや取り消しもありうる段階だ。",
      "マイナーがブロック 870,000 に取引を入れた。これで承認 1。ブロックのヘッダーは、中身と、ブロック 869,999 のハッシュを固定する。",
      "その上にさらに 2 つのブロックが積まれた。いまブロック 870,000 を書き換えるとハッシュが変わって 870,001 からの参照が切れ、それ以降のすべてのブロックの計算をやり直す必要がある。",
      "上に 6 ブロック積まれると、差し替えるにはネットワークの残りを 6 ブロック以上にわたって計算で上回らなければならない。計算力が全体の半分未満の攻撃者なら、成功確率はブロックが 1 つ増えるごとに指数的に下がることをホワイトペーパーが示している。何承認まで待つかは受け取る側が決める。",
      "ブロック 870,000 の金額を 1 つ書き換えてみる。ハッシュは 3e1a… から c90d… に変わるが、ブロック 870,001 には前: 3e1a… と書かれたままなので、どのノードにもそこで鎖が切れているのが見える。書き換えを隠すには、ブロック 870,000 とその後の 5 ブロックすべてを、ネットワークの残りが新しいブロックを積むより速く作り直さなければならない。",
    ],
  },
}[lang];

const W = 110;
const gap = 16;
const bx = (i: number) => 12 + i * (W + gap);
const heights = [869999, 870000, 870001, 870002, 870003, 870004, 870005];
const hashes = ["8c04…", "3e1a…", "b7f2…", "05d9…", "e61c…", "9a3b…", "47ce…"];
const fmtH = (n: number) => n.toLocaleString("en-US");
const mk = `blb-arr-${lang}`;
const confs: (number | string)[] = [0, 1, 3, 6];
---

<div class="blb" data-step="2" data-blb data-lines={JSON.stringify(L.say)}>
  <div class="blb-steps" role="group" aria-label={L.group}>
    {
      L.steps.map((s, i) => (
        <button type="button" data-go={i + 1} aria-pressed={i === 1 ? "true" : "false"}>
          {s}
        </button>
      ))
    }
  </div>
  <svg class="dg" viewBox="0 0 900 290" role="img" aria-label={L.say.join(" ")}>
    <defs>
      <marker id={mk} viewBox="0 0 10 10" refX="10" refY="5" markerWidth="7" markerHeight="7" orient="auto">
        <path d="M0,0 L10,5 L0,10 z" class="fill-ink"></path>
      </marker>
    </defs>
    <text x="12" y="22" class="t-s t-2">← {L.back}</text>
    {
      heights.map((h, i) => (
        <g class={`b${i}`}>
          <rect class="box" x={bx(i)} y="36" width={W} height="140" />
          <text x={bx(i) + 10} y="56" class="t-s">
            {L.block}
          </text>
          <text x={bx(i) + 10} y="74" class="b mono">
            {fmtH(h)}
          </text>
          <text x={bx(i) + 10} y="94" class="mono t-2">
            {L.prev}: {i === 0 ? "61a7…" : hashes[i - 1]}
          </text>
          {i === 1 ? (
            <g>
              <rect class="fill-hl" x={bx(i) + 8} y="106" width={W - 16} height="36" />
              <text x={bx(i) + 14} y="121" class="t-on-hl t-s">
                {L.yours}
              </text>
              <text x={bx(i) + 14} y="136" class="t-on-hl mono">
                5d0c…
              </text>
            </g>
          ) : (
            <g>
              <rect class="box-soft" x={bx(i) + 8} y="106" width={W - 16} height="36" />
              <text x={bx(i) + 16} y="129" class="t-s t-2">
                {L.others}
              </text>
            </g>
          )}
          {i === 1 && (
            <g class="s5">
              <rect class="fill-hl" x={bx(i) + 8} y="106" width={W - 16} height="36" />
              <text x={bx(i) + 14} y="121" class="t-on-hl t-s b">
                {L.edited}
              </text>
              <text x={bx(i) + 14} y="136" class="t-on-hl mono">
                5d0c…
              </text>
            </g>
          )}
          <text x={bx(i) + 10} y="164" class:list={["mono", i === 1 && "n5"]}>
            {L.hash}: {hashes[i]}
          </text>
          {i === 1 && (
            <text x={bx(i) + 10} y="164" class="mono b s5">
              {L.hash}: c90d…
            </text>
          )}
          {i > 0 && (
            <line
              class:list={["ln", i === 2 && "n5"]}
              x1={bx(i)}
              y1="80"
              x2={bx(i - 1) + W}
              y2="80"
              marker-end={`url(#${mk})`}
            />
          )}
          {i === 2 && (
            <g class="s5">
              <line class="ln-1 dash" x1={bx(i)} y1="80" x2={bx(i - 1) + W} y2="80" />
              <text x={bx(i) - 8} y="72" text-anchor="middle" class="b">
                ≠
              </text>
            </g>
          )}
        </g>
      ))
    }

    <g class="mp">
      <rect class="box" x={bx(1)} y="196" width="300" height="56" />
      <text x={bx(1) + 12} y="218" class="t-s">{L.pool}</text>
      <rect class="fill-hl" x={bx(1) + 12} y="226" width="110" height="20" />
      <text x={bx(1) + 20} y="241" class="t-on-hl mono">tx 5d0c…</text>
    </g>

    {
      confs.map((c, i) => (
        <text x="888" y="236" text-anchor="end" class={`b cf cf${i + 1}`}>
          {L.conf}: {c}
        </text>
      ))
    }
    <text x="888" y="236" text-anchor="end" class="b cf cf5">
      {L.broken}
    </text>
  </svg>
  <p class="blb-say" aria-live="polite" data-say>{L.say[1]}</p>
</div>

<style>
  .blb-steps {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 0.9rem;
  }
  .blb-steps button {
    font: inherit;
    font-size: var(--step--1);
    padding: 0.3rem 0.7rem;
    background: var(--sheet);
    color: var(--ink);
    border: 1.5px solid var(--ink);
    cursor: pointer;
  }
  .blb-steps button[aria-pressed="true"] {
    background: var(--ink);
    color: var(--sheet);
  }
  .blb svg {
    min-width: 680px;
  }
  .blb-say {
    margin: 0.9rem 0 0;
    font-size: var(--step--1);
    max-width: 68ch;
    min-height: 4.5em;
  }
  .blb .cf,
  .blb .mp {
    display: none;
  }
  .blb[data-step="1"] .cf1,
  .blb[data-step="2"] .cf2,
  .blb[data-step="3"] .cf3,
  .blb[data-step="4"] .cf4,
  .blb[data-step="1"] .mp,
  .blb[data-step="5"] .cf5,
  .blb[data-step="5"] .s5 {
    display: inline;
  }
  .blb .s5,
  .blb[data-step="5"] .n5 {
    display: none;
  }
  .blb[data-step="1"] :is(.b1, .b2, .b3, .b4, .b5, .b6),
  .blb[data-step="2"] :is(.b2, .b3, .b4, .b5, .b6),
  .blb[data-step="3"] :is(.b4, .b5, .b6) {
    display: none;
  }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>("[data-blb]")) {
    const say = root.querySelector<HTMLElement>("[data-say]")!;
    const lines: string[] = JSON.parse(root.dataset.lines ?? "[]");
    const buttons = [...root.querySelectorAll<HTMLButtonElement>("button[data-go]")];
    const go = (n: number) => {
      root.dataset.step = String(n);
      buttons.forEach((b, i) => b.setAttribute("aria-pressed", String(i + 1 === n)));
      say.textContent = lines[n - 1] ?? "";
    };
    buttons.forEach((b, i) => {
      b.addEventListener("click", () => go(i + 1));
      b.addEventListener("keydown", (e) => {
        const d = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0;
        if (!d) return;
        e.preventDefault();
        const n = (i + d + buttons.length) % buttons.length;
        go(n + 1);
        buttons[n]!.focus();
      });
    });
  }
</script>
