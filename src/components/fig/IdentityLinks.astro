---
// Ulbricht worked example: two clusters that stay apart until one post
// carries a real-name email address into the pseudonym's history.
interface Props {
  lang: "en" | "ja";
}
const { lang } = Astro.props;
const L = {
  en: {
    title: "How one reused edge joined a pseudonym to a real name",
    controls: "Show the graph",
    without: "Without the October 2011 post",
    with: "With it",
    persona: "pseudonym side",
    real: "real-name side",
    sr: "Silk Road",
    srSub: "the hidden market",
    shroom: "“altoid” on Shroomery",
    shroomSub: "27 Jan 2011: asks about it",
    btc: "“altoid” on Bitcoin Talk",
    btcSub: "11 Oct 2011: hiring post",
    gmail: "rossulbricht@gmail.com",
    gmailSub: "contact address",
    name: "Ross Ulbricht",
    nameSub: "Google subscriber record",
    promotes: "mentions the new site",
    sameHandle: "same handle",
    inPost: "address in the post",
    owner: "registered to",
    vOff: "Two separate graphs: an unknown promoter, and an ordinary person.",
    vOn: "One graph: the promoter's handle leads to a name.",
  },
  ja: {
    title: "1 本の使い回しの線が、仮名と実名をつないだ",
    controls: "グラフの表示",
    without: "2011 年 10 月の投稿がない場合",
    with: "ある場合",
    persona: "仮名の側",
    real: "実名の側",
    sr: "Silk Road",
    srSub: "匿名マーケット",
    shroom: "Shroomery の「altoid」",
    shroomSub: "2011 年 1 月 27 日: サイトに言及",
    btc: "Bitcoin Talk の「altoid」",
    btcSub: "2011 年 10 月 11 日: 求人の投稿",
    gmail: "rossulbricht@gmail.com",
    gmailSub: "連絡先として記載",
    name: "Ross Ulbricht",
    nameSub: "Google の契約者記録",
    promotes: "開設直後のサイトに言及",
    sameHandle: "同じハンドル",
    inPost: "投稿にアドレス",
    owner: "登録名義",
    vOff: "グラフは 2 つに分かれている。正体不明の宣伝者と、ふつうの個人。",
    vOn: "グラフは 1 つになる。宣伝者のハンドルから名前までたどれる。",
  },
}[lang];
const tid = `idl-t-${lang}`;
---

<div class="idl" data-idl>
  <div class="ctl" role="group" aria-label={L.controls}>
    <button type="button" class="sc" data-v="off" aria-pressed="true">{L.without}</button>
    <button type="button" class="sc" data-v="on" aria-pressed="false">{L.with}</button>
  </div>
  <svg class="dg" viewBox="0 0 680 430" role="img" aria-labelledby={tid}>
    <title id={tid}>{L.title}</title>
    <defs>
      <marker id={`idl-a-${lang}`} viewBox="0 0 10 10" refX="10" refY="5" markerWidth="8" markerHeight="8" orient="auto">
        <path d="M0,0 L10,5 L0,10 z" class="fill-leak"></path>
      </marker>
    </defs>

    <rect x="10" y="10" width="270" height="360" class="ln-1 soft dash" fill="none"></rect>
    <text x="22" y="32" class="t-s t-2">{L.persona}</text>
    <rect x="400" y="130" width="270" height="240" class="ln-1 soft dash" fill="none"></rect>
    <text x="412" y="152" class="t-s t-2">{L.real}</text>

    <rect x="22" y="44" width="246" height="64" class="box"></rect>
    <text x="38" y="70" class="b">{L.sr}</text>
    <text x="38" y="92" class="t-s t-2">{L.srSub}</text>

    <rect x="22" y="164" width="246" height="64" class="box"></rect>
    <text x="38" y="190" class="b">{L.shroom}</text>
    <text x="38" y="212" class="t-s t-2">{L.shroomSub}</text>

    <rect x="22" y="290" width="246" height="64" class="box"></rect>
    <text x="38" y="316" class="b">{L.btc}</text>
    <text x="38" y="338" class="t-s t-2">{L.btcSub}</text>

    <rect x="412" y="164" width="246" height="64" class="box"></rect>
    <text x="428" y="190" class="b">{L.name}</text>
    <text x="428" y="212" class="t-s t-2">{L.nameSub}</text>

    <rect x="412" y="290" width="246" height="64" class="box"></rect>
    <text x="428" y="316" class="mono b">{L.gmail}</text>
    <text x="428" y="338" class="t-s t-2">{L.gmailSub}</text>

    <line x1="80" y1="108" x2="80" y2="164" class="ln"></line>
    <text x="92" y="141" class="t-s">{L.promotes}</text>
    <line x1="80" y1="228" x2="80" y2="290" class="ln"></line>
    <text x="92" y="264" class="t-s">{L.sameHandle}</text>
    <line x1="470" y1="228" x2="470" y2="290" class="ln"></line>
    <text x="482" y="264" class="t-s">{L.owner}</text>

    <g class="on-only">
      <line x1="268" y1="322" x2="410" y2="322" class="stroke-leak" marker-end={`url(#idl-a-${lang})`}></line>
      <text x="339" y="310" class="t-s t-leak" text-anchor="middle">{L.inPost}</text>
    </g>

    <text x="10" y="404" class="b off-only">{L.vOff}</text>
    <text x="10" y="404" class="b t-leak on-only">{L.vOn}</text>
  </svg>
</div>

<style>
  .ctl {
    display: inline-flex;
    flex-wrap: wrap;
    border: 1.5px solid var(--ink);
    margin-bottom: 1rem;
  }
  .sc {
    font: inherit;
    font-weight: 700;
    font-size: var(--step--1);
    background: transparent;
    color: var(--ink);
    border: 0;
    border-right: 1.5px solid var(--ink);
    padding: 0.4rem 0.85rem;
    cursor: pointer;
  }
  .sc:last-child {
    border-right: 0;
  }
  .sc[aria-pressed="true"] {
    background: var(--ink);
    color: var(--sheet);
  }
  .idl:not([data-on]) .on-only,
  .idl[data-on] .off-only {
    display: none;
  }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>("[data-idl]")) {
    const buttons = root.querySelectorAll<HTMLButtonElement>("button[data-v]");
    for (const b of buttons) {
      b.addEventListener("click", () => {
        const on = b.dataset.v === "on";
        root.toggleAttribute("data-on", on);
        for (const o of buttons) o.setAttribute("aria-pressed", String(o === b));
      });
    }
  }
</script>
