---
// Ulbricht worked example: two clusters that stay apart until one post
// carries a real-name email address into the pseudonym's history.
interface Props {
  lang: "en" | "ja";
}
const { lang } = Astro.props;
const L = {
  en: {
    title: "How one reused edge joined a pseudonym to a real name",
    without: "Without the October 2011 post",
    with: "With the October 2011 post",
    persona: "pseudonym side",
    real: "real-name side",
    sr: "Silk Road",
    srSub: "the hidden market",
    shroom: "“altoid” on Shroomery",
    shroomSub: "27 Jan 2011: asks about it",
    btc: "“altoid” on Bitcoin Talk",
    btcSub: "11 Oct 2011: hiring post",
    gmail: "rossulbricht@gmail.com",
    gmailSub: "contact address",
    name: "Ross Ulbricht",
    nameSub: "Google subscriber record",
    promotes: "mentions the new site",
    sameHandle: "same handle",
    inPost: "address in the post",
    owner: "registered to",
    vOff: "Two separate graphs: an unknown promoter, and an ordinary person.",
    vOn: "One graph: the promoter's handle leads to a name.",
  },
  ja: {
    title: "1 本の使い回しの線が、仮名と実名をつないだ",
    without: "2011 年 10 月の投稿がない場合",
    with: "2011 年 10 月の投稿がある場合",
    persona: "仮名の側",
    real: "実名の側",
    sr: "Silk Road",
    srSub: "匿名マーケット",
    shroom: "Shroomery の「altoid」",
    shroomSub: "2011 年 1 月 27 日: サイトに言及",
    btc: "Bitcoin Talk の「altoid」",
    btcSub: "2011 年 10 月 11 日: 求人の投稿",
    gmail: "rossulbricht@gmail.com",
    gmailSub: "連絡先として記載",
    name: "Ross Ulbricht",
    nameSub: "Google の契約者記録",
    promotes: "開設直後のサイトに言及",
    sameHandle: "同じハンドル",
    inPost: "投稿にアドレス",
    owner: "登録名義",
    vOff: "グラフは 2 つに分かれている。正体不明の宣伝者と、ふつうの個人。",
    vOn: "グラフは 1 つになる。宣伝者のハンドルから名前までたどれる。",
  },
}[lang];
const tid = `idl-t-${lang}`;
const panels = [
  { oy: 0, on: false, head: L.without, verdict: L.vOff },
  { oy: 320, on: true, head: L.with, verdict: L.vOn },
];
---

<svg class="dg" viewBox="0 0 680 640" role="img" aria-labelledby={tid}>
  <title id={tid}>{L.title}</title>
  <defs>
    <marker id={`idl-a-${lang}`} viewBox="0 0 10 10" refX="10" refY="5" markerWidth="8" markerHeight="8" orient="auto">
      <path d="M0,0 L10,5 L0,10 z" class="fill-leak"></path>
    </marker>
  </defs>
  {
    panels.map(({ oy, on, head, verdict }) => (
      <g>
        <text x="10" y={oy + 20} class="t-l">
          {head}
        </text>
        <rect x="10" y={oy + 32} width="270" height="240" class="ln-1 soft dash" fill="none" />
        <text x="22" y={oy + 50} class="t-s t-2">
          {L.persona}
        </text>
        <rect x="400" y={oy + 112} width="270" height="160" class="ln-1 soft dash" fill="none" />
        <text x="412" y={oy + 130} class="t-s t-2">
          {L.real}
        </text>

        <rect x="22" y={oy + 58} width="246" height="54" class="box" />
        <text x="36" y={oy + 80} class="b">
          {L.sr}
        </text>
        <text x="36" y={oy + 100} class="t-s t-2">
          {L.srSub}
        </text>

        <rect x="22" y={oy + 136} width="246" height="54" class="box" />
        <text x="36" y={oy + 158} class="b">
          {L.shroom}
        </text>
        <text x="36" y={oy + 178} class="t-s t-2">
          {L.shroomSub}
        </text>

        <rect x="22" y={oy + 210} width="246" height="54" class="box" />
        <text x="36" y={oy + 232} class="b">
          {L.btc}
        </text>
        <text x="36" y={oy + 252} class="t-s t-2">
          {L.btcSub}
        </text>

        <rect x="412" y={oy + 136} width="246" height="54" class="box" />
        <text x="426" y={oy + 158} class="b">
          {L.name}
        </text>
        <text x="426" y={oy + 178} class="t-s t-2">
          {L.nameSub}
        </text>

        <rect x="412" y={oy + 210} width="246" height="54" class="box" />
        <text x="426" y={oy + 232} class="mono b">
          {L.gmail}
        </text>
        <text x="426" y={oy + 252} class="t-s t-2">
          {L.gmailSub}
        </text>

        <line x1="80" y1={oy + 112} x2="80" y2={oy + 136} class="ln" />
        <text x="92" y={oy + 129} class="t-s">
          {L.promotes}
        </text>
        <line x1="80" y1={oy + 190} x2="80" y2={oy + 210} class="ln" />
        <text x="92" y={oy + 204} class="t-s">
          {L.sameHandle}
        </text>
        <line x1="470" y1={oy + 190} x2="470" y2={oy + 210} class="ln" />
        <text x="482" y={oy + 204} class="t-s">
          {L.owner}
        </text>

        {on && (
          <g>
            <line x1="268" y1={oy + 237} x2="410" y2={oy + 237} class="stroke-leak" marker-end={`url(#idl-a-${lang})`} />
            <text x="339" y={oy + 227} class="t-s t-leak" text-anchor="middle">
              {L.inPost}
            </text>
          </g>
        )}
        <text x="10" y={oy + 298} class={on ? "b t-leak" : "b"}>
          {verdict}
        </text>
      </g>
    ))
  }
  <line x1="10" y1="312" x2="670" y2="312" class="ln-1 soft"></line>
</svg>
