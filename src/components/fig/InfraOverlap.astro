---
// Overlap graph from the 2018 GRU indictment (US v. Netyksho et al.):
// two personas meet at one bitcoin pool and at a GRU-managed server.
interface Props {
  lang: "en" | "ja";
}
const { lang } = Astro.props;

type Node = { id: string; x: number; y: number; w: number; a: string; b: string; kind?: "persona" | "org" };
const N = {
  en: {
    g2: ["Guccifer 2.0", "persona"],
    dcl: ["DCLeaks", "persona"],
    post: ["First post, 15 Jun 2016", "“some hundred sheets”"],
    vpn: ["VPN account", "logs in to @Guccifer_2"],
    srv: ["Server in Malaysia", "hosted dcleaks.com"],
    search: ["Searches, 15 Jun 2016", "earlier that day"],
    pool: ["One pool of bitcoin", "paid for both"],
    msk: ["Moscow server", "GRU Unit 74455"],
    e: {
      posted: "posted",
      via: "logged in via",
      host: "hosted on",
      paid: "paid from",
      also: "also paid",
      same: "same phrases",
      on: "run on",
    },
  },
  ja: {
    g2: ["Guccifer 2.0", "ペルソナ"],
    dcl: ["DCLeaks", "ペルソナ"],
    post: ["最初の投稿 (2016/6/15)", "「some hundred sheets」"],
    vpn: ["VPN アカウント", "@Guccifer_2 へのログイン"],
    srv: ["マレーシアのサーバ", "dcleaks.com を置いた"],
    search: ["検索 (2016/6/15)", "同じ日の投稿より前"],
    pool: ["1 つの bitcoin プール", "両方の代金を支払う"],
    msk: ["モスクワのサーバ", "GRU 74455 部隊"],
    e: {
      posted: "投稿",
      via: "ログイン",
      host: "置き場所",
      paid: "支払い元",
      also: "同じ資金",
      same: "同じフレーズ",
      on: "実行場所",
    },
  },
}[lang];

const h = 56;
const nodes: Record<string, Node> = {
  g2: { id: "g2", x: 20, y: 70, w: 170, a: N.g2[0]!, b: N.g2[1]!, kind: "persona" },
  dcl: { id: "dcl", x: 20, y: 300, w: 170, a: N.dcl[0]!, b: N.dcl[1]!, kind: "persona" },
  post: { id: "post", x: 300, y: 20, w: 200, a: N.post[0]!, b: N.post[1]! },
  vpn: { id: "vpn", x: 300, y: 150, w: 200, a: N.vpn[0]!, b: N.vpn[1]! },
  srv: { id: "srv", x: 300, y: 300, w: 200, a: N.srv[0]!, b: N.srv[1]! },
  search: { id: "search", x: 620, y: 20, w: 190, a: N.search[0]!, b: N.search[1]! },
  pool: { id: "pool", x: 620, y: 225, w: 190, a: N.pool[0]!, b: N.pool[1]! },
  msk: { id: "msk", x: 930, y: 20, w: 150, a: N.msk[0]!, b: N.msk[1]!, kind: "org" },
};

// One traced path from DCLeaks to the GRU server, numbered in reading order.
// Geometry: each edge runs from the right side of the left node to the left
// side of the right node; the number gives the order along the path.
const edges: [string, string, string, number][] = [
  ["dcl", "srv", N.e.host, 1],
  ["srv", "pool", N.e.paid, 2],
  ["vpn", "pool", N.e.also, 3],
  ["g2", "vpn", N.e.via, 4],
  ["g2", "post", N.e.posted, 5],
  ["post", "search", N.e.same, 6],
  ["search", "msk", N.e.on, 7],
];
const cy = (n: Node) => n.y + h / 2;
---

<svg class="dg" viewBox="0 0 1100 380" role="img" aria-label={Object.values(nodes).map((n) => `${n.a} (${n.b})`).join("; ")}>
  {
    edges.map(([f, t, label, n]) => {
      const a = nodes[f]!;
      const b = nodes[t]!;
      const x1 = a.x + a.w;
      const y1 = cy(a);
      const x2 = b.x;
      const y2 = cy(b);
      const mx = (x1 + x2) / 2;
      const my = (y1 + y2) / 2;
      return (
        <g>
          <line class="stroke-leak" x1={x1} y1={y1} x2={x2} y2={y2} style="stroke-width:3" />
          <rect class="fill-paper" x={mx - 52} y={my - 11} width="108" height="22" />
          <circle class="fill-leak" cx={mx - 40} cy={my} r="9" />
          <text x={mx - 40} y={my + 4} text-anchor="middle" class="t-s b t-on-ink">
            {n}
          </text>
          <text x={mx - 27} y={my + 4} class="t-s t-leak">
            {label}
          </text>
        </g>
      );
    })
  }
  {
    Object.values(nodes).map((n) => (
      <g>
        <rect class={n.kind === "org" ? "stroke-leak" : "box"} x={n.x} y={n.y} width={n.w} height={h} style={n.kind === "org" ? "stroke-width:3" : undefined} />
        <text x={n.x + 12} y={n.y + 23} class:list={["b", n.kind === "org" && "t-leak"]}>
          {n.a}
        </text>
        <text x={n.x + 12} y={n.y + 43} class:list={["t-s t-2", n.b.includes(".com") && "mono"]}>
          {n.b}
        </text>
      </g>
    ))
  }
</svg>
