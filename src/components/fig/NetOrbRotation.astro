---
// ORB network: the defender sees only the exit node; nodes rotate so an IP
// blocklist built at one moment misses the nodes in use later.
interface Props {
  lang: "en" | "ja";
}
const { lang } = Astro.props;

const T = {
  en: {
    path: ["Operator server", "Relay VPS", "Traversal nodes", "Exit node", "Victim"],
    sees: "Defender sees",
    near: "a home router nearby",
    tl: "Node lifetimes (illustrative)",
    built: "blocklist built, day 40",
    today: "traffic on day 75",
    day: (d: number) => `day ${d}`,
    keyOn: "on the blocklist",
    keyOff: "not on the blocklist",
  },
  ja: {
    path: ["運営サーバ", "中継 VPS", "経由ノード群", "出口ノード", "被害組織"],
    sees: "防御側に見える",
    near: "近くの家庭用ルータ",
    tl: "ノードの寿命 (説明用)",
    built: "40 日目にリスト作成",
    today: "75 日目の通信",
    day: (d: number) => `${d} 日目`,
    keyOn: "ブロックリストにある",
    keyOff: "ブロックリストにない",
  },
}[lang];

const px = [20, 196, 372, 548, 724];
const bw = 152;

const nodes: [string, number, number][] = [
  ["198.51.100.14", 0, 31],
  ["203.0.113.61", 5, 38],
  ["198.51.100.90", 18, 52],
  ["203.0.113.7", 33, 66],
  ["198.51.100.143", 47, 84],
  ["203.0.113.201", 60, 96],
  ["198.51.100.36", 72, 110],
];
const tx = (d: number) => 170 + d * 5.9;
const ty0 = 236;
const rh = 30;
const built = 40;
const today = 75;
const exitIp = "198.51.100.143";
---

<svg class="dg" viewBox="0 0 900 496" role="img" aria-label={`${T.sees}: ${T.path[3]!}. ${T.built}; ${T.today}.`}>
  {
    T.path.map((p, i) => (
      <g>
        <rect class="box" x={px[i]!} y="12" width={bw} height="44" />
        <text x={px[i]! + bw / 2} y="39" text-anchor="middle" class="b">
          {p}
        </text>
        {i < 4 && (
          <g>
            <line class="ln" x1={px[i]! + bw} y1="34" x2={px[i + 1]! - 8} y2="34" />
            <path class="fill-ink" d={`M ${px[i + 1]!} 34 l -9 -5 v 10 z`} />
          </g>
        )}
      </g>
    ))
  }
  <defs>
    <pattern id="orb-hatch" patternUnits="userSpaceOnUse" width="6" height="6" patternTransform="rotate(45)">
      <line class="ln-1" x1="0" y1="0" x2="0" y2="6" />
    </pattern>
  </defs>
  <text x="20" y="84" class="t-s t-2">{T.sees}</text>
  {[0, 1, 2].map((i) => <rect class="fill-bar" x={px[i]! + 16} y="94" width={bw - 32} height="24" />)}
  <rect class="fill-hl" x={px[3]! + 8} y="94" width={bw - 16} height="24" />
  <text x={px[3]! + bw / 2} y="111" text-anchor="middle" class="mono t-on-hl">{exitIp}</text>
  <text x={px[3]! + bw / 2} y="138" text-anchor="middle" class="t-s t-2">{T.near}</text>

  <line class="ln-1 soft" x1="20" y1="160" x2="880" y2="160" />

  <text x="20" y="190" class="b t-s">{T.tl}</text>
  <rect class="ln-1" x="420" y="178" width="20" height="14" style="fill:url(#orb-hatch)" />
  <text x="446" y="190" class="t-s">{T.keyOn}</text>
  <rect class="box-soft" x="640" y="178" width="20" height="14" />
  <text x="666" y="190" class="t-s">{T.keyOff}</text>

  <!-- markers -->
  <line class="ln-1 dash" x1={tx(built)} y1="214" x2={tx(built)} y2={ty0 + rh * nodes.length} />
  <text x={tx(built)} y="208" text-anchor="middle" class="t-s b">{T.built}</text>
  <line class="ln dash" x1={tx(today)} y1="214" x2={tx(today)} y2={ty0 + rh * nodes.length} />
  <text x={tx(today) + 4} y="208" class="t-s b">{T.today}</text>

  {
    nodes.map(([ip, a, b], i) => {
      const y = ty0 + rh * i;
      const listed = a <= built;
      return (
        <g>
          {ip === exitIp && <rect class="fill-hl" x="14" y={y - 2} width="124" height="22" />}
          <text x="20" y={y + 14} class:list={["mono", ip === exitIp && "t-on-hl"]}>
            {ip}
          </text>
          {listed ? (
            <rect class="ln-1" x={tx(a)} y={y} width={tx(b) - tx(a)} height="18" style="fill:url(#orb-hatch)" />
          ) : (
            <rect class="box-soft" x={tx(a)} y={y} width={tx(b) - tx(a)} height="18" />
          )}
        </g>
      );
    })
  }

  <line class="ln-1" x1={tx(0)} y1="458" x2={tx(120)} y2="458" />
  {
    [0, 30, 60, 90, 120].map((d) => (
      <g>
        <line class="ln-1" x1={tx(d)} y1="458" x2={tx(d)} y2="464" />
        <text x={tx(d)} y="482" text-anchor="middle" class="t-s t-2">
          {T.day(d)}
        </text>
      </g>
    ))
  }
</svg>
