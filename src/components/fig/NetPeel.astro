---
// Small multiples: the same request at four points on a Tor circuit. Each
// frame shows the envelopes still wrapped around the request and what that
// point can read. Static on purpose: the comparison is the point.
interface Props {
  lang: "en" | "ja";
}
const { lang } = Astro.props;

type Val = { k: "hl" | "bar" | "leak"; t?: string };
interface Frame {
  name: string;
  addr: string;
  peeled: number; // envelopes already opened (0..3)
  note: string;
  letter: "hl" | "bar";
  rows: Val[]; // sender, passes to, destination, content
}

const YOU = "198.51.100.23";
const GUARD = "192.0.2.14";
const MIDDLE = "192.0.2.77";
const EXIT = "192.0.2.201";
const SITE = "forum.example";

const L = {
  en: {
    layers: ["guard layer", "middle layer", "exit layer"],
    letter: `request to ${SITE}`,
    read: "What this point can read",
    rows: ["Sender address", "Passes it to", "Destination", "Content"],
  },
  ja: {
    layers: ["ガード用の層", "中間用の層", "出口用の層"],
    letter: `${SITE} への要求`,
    read: "この地点で読めるもの",
    rows: ["送信元", "渡す先", "宛先", "中身"],
  },
}[lang];

const frames: Frame[] =
  lang === "en"
    ? [
        {
          name: "You",
          addr: YOU,
          peeled: 0,
          note: "wraps the request three times",
          letter: "hl",
          rows: [
            { k: "leak", t: `${YOU} (you)` },
            { k: "hl", t: GUARD },
            { k: "hl", t: SITE },
            { k: "hl", t: "your request" },
          ],
        },
        {
          name: "Guard",
          addr: GUARD,
          peeled: 1,
          note: "opens the guard layer",
          letter: "bar",
          rows: [{ k: "leak", t: `${YOU} (you)` }, { k: "hl", t: `${MIDDLE} (middle)` }, { k: "bar" }, { k: "bar" }],
        },
        {
          name: "Middle",
          addr: MIDDLE,
          peeled: 2,
          note: "opens the middle layer",
          letter: "bar",
          rows: [{ k: "hl", t: `${GUARD} (guard)` }, { k: "hl", t: `${EXIT} (exit)` }, { k: "bar" }, { k: "bar" }],
        },
        {
          name: "Exit",
          addr: EXIT,
          peeled: 3,
          note: "opens the last layer; TLS remains",
          letter: "hl",
          rows: [{ k: "hl", t: `${MIDDLE} (middle)` }, { k: "hl", t: SITE }, { k: "hl", t: SITE }, { k: "bar" }],
        },
      ]
    : [
        {
          name: "本人",
          addr: YOU,
          peeled: 0,
          note: "要求を 3 重に包む",
          letter: "hl",
          rows: [
            { k: "leak", t: `${YOU} (本人)` },
            { k: "hl", t: GUARD },
            { k: "hl", t: SITE },
            { k: "hl", t: "本人の要求" },
          ],
        },
        {
          name: "ガード",
          addr: GUARD,
          peeled: 1,
          note: "ガード用の層を開ける",
          letter: "bar",
          rows: [{ k: "leak", t: `${YOU} (本人)` }, { k: "hl", t: `${MIDDLE} (中間)` }, { k: "bar" }, { k: "bar" }],
        },
        {
          name: "中間",
          addr: MIDDLE,
          peeled: 2,
          note: "中間用の層を開ける",
          letter: "bar",
          rows: [{ k: "hl", t: `${GUARD} (ガード)` }, { k: "hl", t: `${EXIT} (出口)` }, { k: "bar" }, { k: "bar" }],
        },
        {
          name: "出口",
          addr: EXIT,
          peeled: 3,
          note: "最後の層を開ける。TLS は残る",
          letter: "hl",
          rows: [{ k: "hl", t: `${MIDDLE} (中間)` }, { k: "hl", t: SITE }, { k: "hl", t: SITE }, { k: "bar" }],
        },
      ];

const FW = 250; // frame width
const GAP = 60;
// 2 x 2 grid so the text stays readable at the column width.
const fx = (i: number) => 20 + (i % 2) * (FW + GAP);
const fy = (i: number) => Math.floor(i / 2) * 530;
const EY = 96; // envelope area top
const EH = 150;
const RY = 290; // record area top

// An envelope: rectangle plus a short flap in the middle of its top edge.
const env = (x: number, y: number, w: number, h: number) => ({
  x,
  y,
  w,
  h,
  flap: `M ${x + w / 2 - 14} ${y} L ${x + w / 2} ${y + 12} L ${x + w / 2 + 14} ${y}`,
});
---

<svg class="dg" viewBox="0 0 600 1020" role="img" aria-label={frames.map((f) => `${f.name}: ${f.note}`).join(". ")}>
  <line class="ln-1 soft" x1="20" y1="510" x2="580" y2="510" />
  {
    frames.map((f, i) => {
      const x = fx(i);
      const oy = fy(i);
      const remaining = 3 - f.peeled;
      const envs = Array.from({ length: remaining }, (_, d) =>
        env(x + d * 16, EY + d * 28, FW - d * 32, EH - d * 28 - d * 10),
      );
      const inner = envs[envs.length - 1];
      const lx = inner ? inner.x + 14 : x + 14;
      const lw = inner ? inner.w - 28 : FW - 28;
      const ly = inner ? inner.y + 30 : EY + 60;
      return (
        <g transform={`translate(0 ${oy})`}>
          <text x={x} y="22" class="b">
            {i + 1}. {f.name}
          </text>
          <text x={x} y="42" class="mono t-2">
            {f.addr}
          </text>
          {i % 2 === 0 && (
            <g>
              <line class="ln" x1={x + 150} y1="30" x2={fx(i + 1) - 10} y2="30" />
              <path class="fill-ink" d={`M ${fx(i + 1) - 2} 30 l -9 -5 v 10 z`} />
            </g>
          )}
          <text x={x} y="74" class="t-s t-2">
            {f.note}
          </text>
          {envs.map((e, d) => (
            <g>
              <rect class="box" x={e.x} y={e.y} width={e.w} height={e.h} />
              <path class="ln-1" d={e.flap} />
              <text x={e.x + 8} y={e.y + 17} class="t-s">
                {L.layers[f.peeled + d]!}
              </text>
            </g>
          ))}
          <rect class={f.letter === "hl" ? "fill-hl" : "fill-bar"} x={lx} y={ly} width={lw} height="28" />
          {f.letter === "hl" && (
            <text x={lx + 8} y={ly + 19} class="t-s t-on-hl">
              {L.letter}
            </text>
          )}

          <text x={x} y={RY} class="b t-s">
            {L.read}
          </text>
          {f.rows.map((r, j) => {
            const y = RY + 16 + j * 48;
            return (
              <g>
                <text x={x} y={y + 6} class="t-s t-2">
                  {L.rows[j]!}
                </text>
                {r.k === "hl" && <rect class="fill-hl" x={x} y={y + 12} width={FW} height="26" />}
                {r.k === "bar" && <rect class="fill-bar" x={x} y={y + 12} width={FW} height="26" />}
                {r.k === "leak" && <rect class="stroke-leak" x={x} y={y + 12} width={FW} height="26" />}
                {r.t && (
                  <text
                    x={x + 8}
                    y={y + 30}
                    class:list={[
                      r.t.includes(".") ? "mono" : "t-s",
                      r.k === "hl" && "t-on-hl",
                      r.k === "leak" && "t-leak",
                    ]}
                  >
                    {r.t}
                  </text>
                )}
              </g>
            );
          })}
        </g>
      );
    })
  }
</svg>
