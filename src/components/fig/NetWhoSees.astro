---
// Matrix: for each routing setup and each observer, does the observer learn
// who you are, where you went, or both (magenta corner tag).
interface Props {
  lang: "en" | "ja";
}
const { lang } = Astro.props;

// y = readable, n = hidden, a = identified through the paid account, - = not on the path
type C = "y" | "n" | "a" | "-";
type Cell = [you: C, dest: C] | null;

const T = {
  en: {
    cols: ["ISP", "VPN provider", "Guard", "Exit", "Website"],
    rows: ["Direct", "VPN", "Tor", "VPN, then Tor", "Tor, then VPN"],
    you: "you",
    acct: "account",
    dest: "dest.",
    off: "not on path",
    legend: ["identity readable", "destination readable", "hidden", "holds both ends"],
    both: "both",
    note: "Tor, then VPN: the VPN provider sees the exit, not your address, but the paid account names you and every session leaves through it.",
  },
  ja: {
    cols: ["ISP", "VPN", "ガード", "出口", "サイト"],
    rows: ["直接", "VPN", "Tor", "VPN → Tor", "Tor → VPN"],
    you: "本人",
    acct: "契約",
    dest: "宛先",
    off: "経路外",
    legend: ["本人が読める", "宛先が読める", "見えない", "両端を握る"],
    both: "両端",
    note: "Tor → VPN: VPN に見えるのは出口で本人のアドレスではない。だが有料の契約が本人を示し、すべてのセッションがそこから出ていく。",
  },
}[lang];

const grid: Cell[][] = [
  // ISP, VPN, guard, exit, site
  [["y", "y"], null, null, null, ["y", "y"]],
  [["y", "n"], ["y", "y"], null, null, ["n", "y"]],
  [["y", "n"], null, ["y", "n"], ["n", "y"], ["n", "y"]],
  [
    ["y", "n"],
    ["y", "n"],
    ["n", "n"],
    ["n", "y"],
    ["n", "y"],
  ],
  [
    ["y", "n"],
    ["a", "y"],
    ["y", "n"],
    ["n", "n"],
    ["n", "y"],
  ],
];

const x0 = 160;
const cw = 150;
const y0 = 96;
const rh = 64;
const W = x0 + cw * 5 + 10;
const H = y0 + rh * 5 + 44;
---

<svg class="dg" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={T.legend.join(", ")}>
  <!-- legend -->
  <g>
    <rect class="stroke-leak" x="0" y="4" width="22" height="16" />
    <text x="30" y="17" class="t-s">{T.legend[0]}</text>
    <rect class="fill-hl" x="170" y="4" width="22" height="16" />
    <text x="200" y="17" class="t-s">{T.legend[1]}</text>
    <rect class="fill-bar" x="340" y="4" width="22" height="16" />
    <text x="370" y="17" class="t-s">{T.legend[2]}</text>
    <rect class="fill-leak" x="470" y="3" width="44" height="18" />
    <text x="492" y="16" text-anchor="middle" class="t-s b t-on-ink">{T.both}</text>
    <text x="532" y="17" class="t-s">{T.legend[3]}</text>
  </g>

  {
    T.cols.map((c, j) => (
      <text x={x0 + cw * j + cw / 2} y={y0 - 16} text-anchor="middle" class="b t-s">
        {c}
      </text>
    ))
  }
  <line class="ln" x1="0" y1={y0 - 4} x2={W - 10} y2={y0 - 4} />

  {
    grid.map((row, i) => {
      const y = y0 + rh * i;
      return (
        <g>
          <text x="0" y={y + rh / 2 + 5} class="b">
            {T.rows[i]}
          </text>
          <line class="ln-1 soft" x1="0" y1={y + rh} x2={W - 10} y2={y + rh} />
          {row.map((cell, j) => {
            const cx = x0 + cw * j;
            if (!cell)
              return (
                <text x={cx + cw / 2} y={y + rh / 2 + 4} text-anchor="middle" class="t-s t-2">
                  {T.off}
                </text>
              );
            const [u, d] = cell;
            const both = u !== "n" && d === "y";
            const chipY = y + 18;
            return (
              <g>
                {both && (
                  <g>
                    <rect class="fill-leak" x={cx + cw - 52} y={y + 1} width="44" height="16" />
                    <text x={cx + cw - 30} y={y + 13} text-anchor="middle" class="t-s b t-on-ink">
                      {T.both}
                    </text>
                  </g>
                )}
                {u === "n" ? (
                  <rect class="fill-bar" x={cx + 16} y={chipY} width="56" height="28" />
                ) : (
                  <g>
                    <rect class="stroke-leak" x={cx + 16} y={chipY} width="56" height="28" />
                    <text x={cx + 44} y={chipY + 19} text-anchor="middle" class="t-s t-leak">
                      {u === "a" ? T.acct : T.you}
                    </text>
                  </g>
                )}
                {d === "n" ? (
                  <rect class="fill-bar" x={cx + 78} y={chipY} width="56" height="28" />
                ) : (
                  <g>
                    <rect class="fill-hl" x={cx + 78} y={chipY} width="56" height="28" />
                    <text x={cx + 106} y={chipY + 19} text-anchor="middle" class="t-s t-on-hl">
                      {T.dest}
                    </text>
                  </g>
                )}
              </g>
            );
          })}
        </g>
      );
    })
  }
  <text x="0" y={H - 12} class="t-s t-2">
    {T.note}
  </text>
</svg>
