---
// Olympic Destroyer: the planted Rich header against the rest of the binary.
interface Props {
  lang: "en" | "ja";
}
const { lang } = Astro.props;

const L = {
  en: {
    label:
      "Olympic Destroyer's Rich header claimed a Visual Studio 6 build and matched a Lazarus sample byte for byte, which pointed at North Korea. The rest of the file imported mscoree.dll, which did not exist for Visual Studio 6, and carried Visual Studio 2010 startup code. Kaspersky concluded the header was copied in. In 2020 the US charged six officers of GRU Unit 74455.",
    left: "What the Rich header claims",
    right: "What the rest of the file shows",
    l1: ["built with", "Visual Studio 6"],
    l2: ["byte-identical to the header", "of a Lazarus sample"],
    r1: ["imports mscoree.dll", "(did not exist for VS6)"],
    r2: ["startup code matches", "Visual Studio 2010"],
    suggests: "suggests: North Korea",
    verdict: "Kaspersky, March 2018: the header was copied in. A false flag.",
    charge: "October 2020: US charges six officers of GRU Unit 74455",
  },
  ja: {
    label:
      "Olympic Destroyer の Rich ヘッダは Visual Studio 6 でのビルドを主張し、Lazarus の検体とバイト単位で一致していた。これは北朝鮮を指す。ところがファイル本体は Visual Studio 6 の時代に存在しない mscoree.dll を読み込み、スタートアップコードは Visual Studio 2010 のものだった。Kaspersky はヘッダが写されたものだと結論した。2020 年、米国は GRU 74455 部隊の将校 6 人を起訴した。",
    left: "Rich ヘッダの主張",
    right: "ファイル本体が示すもの",
    l1: ["ビルド環境は", "Visual Studio 6"],
    l2: ["Lazarus の検体のヘッダと", "バイト単位で同一"],
    r1: ["mscoree.dll を読み込む", "(VS6 の時代には存在しない)"],
    r2: ["スタートアップコードは", "Visual Studio 2010 のもの"],
    suggests: "示唆: 北朝鮮",
    verdict: "Kaspersky (2018 年 3 月): ヘッダは他から写したもの。偽旗。",
    charge: "2020 年 10 月: 米国が GRU 74455 部隊の将校 6 人を起訴",
  },
}[lang];
const mid = `rh-arr-${lang}`;
---

<svg class="dg" viewBox="0 0 680 392" role="img" aria-label={L.label}>
  <defs>
    <marker id={mid} viewBox="0 0 10 10" refX="10" refY="5" markerWidth="7" markerHeight="7" orient="auto">
      <path d="M0,0 L10,5 L0,10 z" class="fill-ink"></path>
    </marker>
  </defs>

  <text class="b" x="20" y="30">{L.left}</text>
  <text class="b" x="360" y="30">{L.right}</text>

  <rect class="fill-hl" x="20" y="46" width="300" height="56"></rect>
  <text class="t-on-hl" x="32" y="70">{L.l1[0]}</text>
  <text class="t-on-hl b" x="32" y="90">{L.l1[1]}</text>
  <rect class="fill-hl" x="20" y="116" width="300" height="56"></rect>
  <text class="t-on-hl" x="32" y="140">{L.l2[0]}</text>
  <text class="t-on-hl" x="32" y="160">{L.l2[1]}</text>

  <rect class="box" x="360" y="46" width="300" height="56"></rect>
  <text class="b" x="372" y="70">{L.r1[0]}</text>
  <text class="t-s t-2" x="372" y="90">{L.r1[1]}</text>
  <rect class="box" x="360" y="116" width="300" height="56"></rect>
  <text x="372" y="140">{L.r2[0]}</text>
  <text class="b" x="372" y="160">{L.r2[1]}</text>

  <text class="t-l" x="340" y="80" text-anchor="middle">≠</text>
  <text class="t-l" x="340" y="150" text-anchor="middle">≠</text>

  <line class="ln-1" x1="170" y1="172" x2="170" y2="196" marker-end={`url(#${mid})`}></line>
  <rect class="box-soft dash" x="20" y="196" width="300" height="40"></rect>
  <text x="32" y="221">{L.suggests}</text>

  <line class="ln-1" x1="510" y1="172" x2="510" y2="258" marker-end={`url(#${mid})`}></line>
  <rect class="box" x="20" y="258" width="640" height="44"></rect>
  <text class="b" x="32" y="285">{L.verdict}</text>

  <line class="ln-1" x1="340" y1="302" x2="340" y2="330" marker-end={`url(#${mid})`}></line>
  <rect class="stroke-leak" x="20" y="330" width="640" height="46"></rect>
  <text class="t-leak" x="32" y="358">{L.charge}</text>
</svg>
