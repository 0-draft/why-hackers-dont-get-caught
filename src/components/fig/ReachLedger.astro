---
// Ten US indictments of people hacking for or on behalf of a state, 2014-2025.
// One square per named defendant. Outlined = named, no arrest announced;
// filled = arrested; dashed = a person already named in an earlier row.
// Counts come from the DOJ / FBI releases cited in the essay.
interface Props {
  lang: "en" | "ja";
}
const { lang } = Astro.props;

type Kind = "n" | "r" | "a";
interface Person {
  name: string;
  k: Kind;
}
interface Row {
  year: number;
  who: { en: string; ja: string };
  did: { en: string; ja: string };
  where: { en: string; ja: string };
  groups: Person[][];
  note?: { en: string; ja: string };
}

const n = (name: string): Person => ({ name, k: "n" });
const rows: Row[] = [
  {
    year: 2014,
    who: { en: "PLA Unit 61398", ja: "人民解放軍 61398 部隊" },
    did: { en: "trade secrets from US nuclear, steel and solar firms", ja: "米国の原子力・鉄鋼・太陽光企業の機密" },
    where: { en: "China", ja: "中国" },
    groups: [["Wang Dong", "Sun Kailiang", "Wen Xinyu", "Huang Zhenyu", "Gu Chunhui"].map(n)],
  },
  {
    year: 2016,
    who: { en: "ITSec Team, Mersad (IRGC)", ja: "ITSec Team・Mersad (IRGC)" },
    did: { en: "DDoS on 46 firms, mostly banks; a New York dam", ja: "銀行など 46 社への DDoS、NY 州のダム" },
    where: { en: "Iran", ja: "イラン" },
    groups: [
      [
        "Ahmad Fathi",
        "Hamid Firoozi",
        "Amin Shokohi",
        "Sadegh Ahmadzadegan",
        "Omid Ghaffarinia",
        "Sina Keissar",
        "Nader Saedi",
      ].map(n),
    ],
  },
  {
    year: 2018,
    who: { en: "GRU Units 26165, 74455", ja: "GRU 26165・74455 部隊" },
    did: { en: "hacked the DNC and Clinton campaign, leaked it", ja: "民主党組織とクリントン陣営に侵入し暴露" },
    where: { en: "Russia", ja: "ロシア" },
    groups: [
      [
        "Viktor Netyksho",
        "Boris Antonov",
        "Dmitriy Badin",
        "Ivan Yermakov",
        "Aleksey Lukashev",
        "Sergey Morgachev",
        "Nikolay Kozachek",
        "Pavel Yershov",
        "Artem Malyshev",
        "Aleksandr Osadchuk",
        "Aleksey Potemkin",
        "Anatoliy Kovalev",
      ].map(n),
    ],
  },
  {
    year: 2018,
    who: { en: "Chosun Expo (Lazarus)", ja: "朝鮮エキスポ (Lazarus)" },
    did: { en: "Sony 2014, Bangladesh Bank $81M, WannaCry", ja: "ソニー、バングラデシュ銀行、WannaCry" },
    where: { en: "North Korea", ja: "北朝鮮" },
    groups: [[n("Park Jin Hyok")]],
  },
  {
    year: 2020,
    who: { en: "APT41", ja: "APT41" },
    did: { en: "100+ victims: software, games, telecoms", ja: "ソフト・ゲーム・通信など 100 超の被害者" },
    where: { en: "China, Malaysia", ja: "中国・マレーシア" },
    groups: [
      ["Zhang Haoran", "Tan Dailin", "Jiang Lizhi", "Qian Chuan", "Fu Qiang"].map(n),
      [
        { name: "Wong Ong Hua (arrested in Malaysia)", k: "a" },
        { name: "Ling Yang Ching (arrested in Malaysia)", k: "a" },
      ],
    ],
    note: { en: "2 Malaysians arrested", ja: "マレーシア人 2 人を逮捕" },
  },
  {
    year: 2020,
    who: { en: "GRU Unit 74455 (Sandworm)", ja: "GRU 74455 部隊 (Sandworm)" },
    did: { en: "Ukraine blackouts, NotPetya, Olympics", ja: "ウクライナの停電、NotPetya、五輪" },
    where: { en: "Russia", ja: "ロシア" },
    groups: [
      [
        n("Yuriy Andrienko"),
        n("Sergey Detistov"),
        n("Pavel Frolov"),
        { name: "Anatoliy Kovalev (also named in 2018)", k: "r" },
        n("Artem Ochichenko"),
        n("Petr Pliskin"),
      ],
    ],
    note: { en: "Kovalev, again", ja: "コバレフは 2 度目" },
  },
  {
    year: 2021,
    who: { en: "RGB (Lazarus)", ja: "偵察総局 (Lazarus)" },
    did: { en: "theft and extortion of over $1.3B", ja: "13 億ドル超の窃取と恐喝" },
    where: { en: "North Korea", ja: "北朝鮮" },
    groups: [
      [n("Jon Chang Hyok"), n("Kim Il"), { name: "Park Jin Hyok (also named in 2018)", k: "r" }],
      [{ name: "Ghaleb Alaumary, Canadian launderer, charged separately", k: "a" }],
    ],
    note: { en: "Park, again; + launderer", ja: "朴は 2 度目、+ 資金洗浄役" },
  },
  {
    year: 2021,
    who: { en: "APT40, Hainan State Security", ja: "APT40・海南省国家安全庁" },
    did: { en: "trade secrets, US and 11 other countries", ja: "米国とほか 11 か国から企業秘密" },
    where: { en: "China", ja: "中国" },
    groups: [["Ding Xiaoyang", "Cheng Qingmin", "Zhu Yunmin", "Wu Shurong"].map(n)],
  },
  {
    year: 2024,
    who: { en: "IRGC hack-and-leak", ja: "IRGC のハック・アンド・リーク" },
    did: { en: "Trump campaign email, leaked to Biden camp", ja: "トランプ陣営のメールを盗み流出" },
    where: { en: "Iran", ja: "イラン" },
    groups: [["Masoud Jalili", "Seyyed Ali Aghamiri", "Yaser Balaghi"].map(n)],
  },
  {
    year: 2025,
    who: { en: "i-Soon, MPS, APT27", ja: "i-Soon・公安部・APT27" },
    did: { en: "dissidents, US Treasury, foreign ministries", ja: "反体制派、米財務省、各国の外務省" },
    where: { en: "China", ja: "中国" },
    groups: [
      [
        "Wu Haibo",
        "Chen Cheng",
        "Wang Zhe",
        "Liang Guodong",
        "Ma Li",
        "Wang Yan",
        "Xu Liang",
        "Zhou Weiwei",
        "Wang Liyu",
        "Sheng Jing",
        "Yin Kecheng",
        "Zhou Shuai",
      ].map(n),
    ],
  },
];

// Totals are computed, not typed, so the caption and the drawing cannot drift.
const all = rows.flatMap((r) => r.groups.flat());
const indicted = all.filter((p) => !p.name.includes("charged separately"));
const slots = indicted.length; // 60
const people = indicted.filter((p) => p.k !== "r").length; // 58
const arrested = all.filter((p) => p.k === "a").length; // 3

const L = {
  en: {
    title: "Named in ten US indictments, 2014 to 2025: one square per person",
    zero: "state officers arrested",
    zeroSub: `of ${people} people (${slots} names) in 10 US indictments, 2014 to 2025`,
    others: `Others arrested: ${arrested}`,
    othersSub: "2 Malaysian businessmen, 1 Canadian launderer",
    leg: ["named, no arrest announced", "arrested", "named again"],
    count: (k: number) => `${k}`,
    foot: [
      '"No arrest announced": no later US Justice Department announcement of an arrest,',
      "extradition or guilty plea. The 2021 launderer was charged separately.",
    ],
  },
  ja: {
    title: "米国の 10 件の起訴で名指しされた人 (2014〜2025 年)。1 人 1 マス",
    zero: "逮捕された国家機関の要員",
    zeroSub: `米国の 10 件の起訴 (2014〜2025 年) で名指しされた ${people} 人 (のべ ${slots} 人) のうち`,
    others: `それ以外で逮捕: ${arrested} 人`,
    othersSub: "マレーシアの実業家 2 人、カナダの資金洗浄役 1 人",
    leg: ["名指しのみ (逮捕の発表なし)", "逮捕", "再掲"],
    count: (k: number) => `${k} 人`,
    foot: [
      "「逮捕の発表なし」= その後、米司法省が逮捕・引き渡し・有罪答弁を",
      "発表していない。2021 年の資金洗浄役は別件の起訴で、人数に含めない。",
    ],
  },
}[lang];

// Narrow on purpose: on a phone the year, the unit and the squares are all on
// screen before any horizontal scrolling. Each row: unit, then what the case
// was about, then the squares with the row's count beside them.
const W = 600;
const X = { year: 20, body: 64 };
const S = 20; // square size
const STEP = 26;
const GAP = 16; // extra space between groups in one row
const top = 186;
const RH = 70;
const lastY = top + (rows.length - 1) * RH;
const ruleY = lastY + 66;
const H = ruleY + 56;
---

<!-- biome-ignore lint/a11y/noNoninteractiveTabindex: a scroll container must be focusable for keyboard users (axe scrollable-region-focusable) -->
<div class="rl-wrap" tabindex="0" role="region" aria-label={lang === "ja" ? "名指しされた被告の一覧" : "Named defendants"}>
<svg class="dg rl" viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby={`rl-t-${lang}`}>
  <title id={`rl-t-${lang}`}>{L.title}</title>

  <!-- the point first: zero officers in custody -->
  <text x="20" y="50" class="t-leak" font-size="48">0</text>
  <text x="62" y="34" class="t-l">{L.zero}</text>
  <text x="62" y="54" class="t-s t-2">{L.zeroSub}</text>
  <text x="62" y="84" class="b">{L.others}</text>
  <text x="62" y="102" class="t-s t-2">{L.othersSub}</text>

  <g transform="translate(20 124)">
    <rect x="0" y="0" width={S} height={S} class="stroke-leak"></rect>
    <text x="28" y="15" class="t-s">{L.leg[0]}</text>
    <rect x="230" y="0" width={S} height={S} class="fill-leak"></rect>
    <text x="258" y="15" class="t-s">{L.leg[1]}</text>
    <rect x="330" y="0" width={S} height={S} class="stroke-leak dash"></rect>
    <text x="358" y="15" class="t-s">{L.leg[2]}</text>
  </g>
  <line x1="20" y1="160" x2={W - 20} y2="160" class="ln"></line>

  {
    rows.map((r, i) => {
      const y = top + i * RH;
      let x = X.body;
      const squares: { x: number; p: Person }[] = [];
      r.groups.forEach((g, gi) => {
        if (gi > 0) x += GAP;
        for (const p of g) {
          squares.push({ x, p });
          x += STEP;
        }
      });
      const named = r.groups.flat().filter((p) => !p.name.includes("charged separately")).length;
      const sqY = y + 26;
      return (
        <g>
          {i > 0 && <line x1="20" y1={y - 18} x2={W - 20} y2={y - 18} class="ln-1 soft" />}
          <text x={X.year} y={y} class="mono">
            {r.year}
          </text>
          <text x={X.body} y={y} class="b">
            {r.who[lang]}
          </text>
          <text x={X.body} y={y + 17} class="t-s t-2">
            {r.where[lang]} · {r.did[lang]}
          </text>
          {squares.map(({ x: sx, p }) => (
            <rect
              x={sx}
              y={sqY}
              width={S}
              height={S}
              class:list={[p.k === "a" ? "fill-leak" : "stroke-leak", p.k === "r" && "dash"]}
            >
              <title>{p.name}</title>
            </rect>
          ))}
          <text x={x + 6} y={sqY + 15} class="mono b">
            {L.count(named)}
          </text>
          {r.note && (
            <text x={x + 46} y={sqY + 15} class="t-s t-2">
              {r.note[lang]}
            </text>
          )}
        </g>
      );
    })
  }
  <line x1="20" y1={ruleY} x2={W - 20} y2={ruleY} class="ln-1"></line>
  <text x="20" y={ruleY + 22} class="t-s t-2">{L.foot[0]}</text>
  <text x="20" y={ruleY + 40} class="t-s t-2">{L.foot[1]}</text>
</svg>
<ul class="sr">
  {
    rows.map((r) => (
      <li>
        {r.year}, {r.who[lang]} ({r.where[lang]}), {r.did[lang]}: {r.groups.flat().map((p) => p.name).join(", ")}
      </li>
    ))
  }
</ul>
</div>

<style>
  /* Self-contained so it can sit on the home page as well as in the essay.
     The viewBox is 600 wide: on a phone it keeps 1:1 size and scrolls a
     little; on a desktop it stops at 680px instead of blowing up. */
  .rl-wrap {
    position: relative;
    overflow-x: auto;
  }
  .rl {
    min-width: 600px;
    max-width: 680px;
  }
  .rl rect {
    stroke-width: 2;
  }
</style>
