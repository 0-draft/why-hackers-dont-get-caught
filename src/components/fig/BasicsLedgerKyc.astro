---
// Where names enter: a regulated exchange holds the customer record that the
// ledger lacks. An investigator follows addresses on the public ledger to an
// exchange and asks it, with legal process, who the customer is.
interface Props {
  lang: "en" | "ja";
}
const { lang } = Astro.props;

const L = {
  en: {
    ex: "Exchange (regulated)",
    rec: "Customer record from sign-up",
    f: ["name", "address, date of birth", "ID document checked"],
    acct: "withdrawals of this account",
    ledger: "Public ledger",
    inv: "Investigator",
    steps: [
      "1. follows payments on the ledger",
      "2. sees addr Q was paid out",
      "    by this exchange",
      "3. sends a legal request",
      "4. gets the customer record",
    ],
    withdraw: "withdrawal",
    reads: "reads",
    req: "legal request; the reply names the customer",
  },
  ja: {
    ex: "取引所 (規制対象)",
    rec: "口座開設時の顧客記録",
    f: ["氏名", "住所・生年月日", "本人確認書類を確認済み"],
    acct: "この口座からの出金",
    ledger: "公開台帳",
    inv: "捜査する側",
    steps: [
      "1. 台帳で支払いをたどる",
      "2. addr Q への出金元が",
      "    この取引所だとわかる",
      "3. 法的な手続きで照会する",
      "4. 顧客記録を受け取る",
    ],
    withdraw: "出金",
    reads: "読む",
    req: "法的手続きによる照会。回答に顧客の名前が載る",
  },
}[lang];

const mk = `blk-kyc-arr-${lang}`;
---

<svg class="dg" viewBox="0 0 900 340" role="img" aria-label={`${L.ex}: ${L.f.join(", ")}. ${L.steps.join(" ")}`}>
  <defs>
    <marker id={mk} viewBox="0 0 10 10" refX="10" refY="5" markerWidth="7" markerHeight="7" orient="auto">
      <path d="M0,0 L10,5 L0,10 z" class="fill-ink"></path>
    </marker>
  </defs>

  <!-- exchange -->
  <rect class="box" x="16" y="16" width="274" height="250" />
  <text x="30" y="40" class="b">{L.ex}</text>
  <text x="30" y="66" class="t-s t-2">{L.rec}</text>
  {
    L.f.map((f, i) => (
      <g>
        <rect class="stroke-leak" x="30" y={76 + i * 36} width="246" height="28" />
        <text x="42" y={95 + i * 36} class="t-s t-leak">
          {f}
        </text>
      </g>
    ))
  }
  <text x="30" y="210" class="t-s t-2">{L.acct}</text>
  <rect class="fill-hl" x="30" y="220" width="246" height="30" />
  <text x="42" y="240" class="t-on-hl mono">→ addr Q</text>

  <!-- ledger -->
  <rect class="box" x="360" y="16" width="220" height="250" />
  <text x="374" y="40" class="b">{L.ledger}</text>
  {
    ["addr Q → addr R  0.40", "addr R → addr S  0.39", "addr S → addr T  0.20", "addr S → addr U  0.19"].map((r, i) => (
      <g>
        <rect class="fill-hl" x="374" y={58 + i * 44} width="192" height="30" />
        <text x="384" y={78 + i * 44} class="t-on-hl mono">
          {r}
        </text>
      </g>
    ))
  }
  <line class="ln" x1="290" y1="235" x2="360" y2="235" marker-end={`url(#${mk})`} />
  <text x="325" y="226" text-anchor="middle" class="t-s">{L.withdraw}</text>

  <!-- investigator -->
  <rect class="box" x="620" y="16" width="264" height="250" />
  <text x="634" y="40" class="b">{L.inv}</text>
  {
    L.steps.map((s, i) => (
      <text x="634" y={70 + i * 24} class="t-s">
        {s}
      </text>
    ))
  }
  <line class="ln" x1="620" y1="140" x2="580" y2="140" marker-end={`url(#${mk})`} />
  <text x="600" y="131" text-anchor="middle" class="t-s">{L.reads}</text>

  <!-- legal request back to the exchange -->
  <path class="ln" fill="none" d="M 752 266 V 296 H 153 V 266" marker-end={`url(#${mk})`} />
  <text x="467" y="322" text-anchor="middle" class="t-s">{L.req}</text>
</svg>
