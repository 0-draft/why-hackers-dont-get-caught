---
// The working weeks that five published reports describe, each drawn in the
// local time the report settled on. Only what the report states is filled;
// anything it does not state is left blank and labelled. The point is that
// the shape (lunch break, Saturday start, seven-day shifts) says something
// beyond the time zone.
interface Props {
  lang: "en" | "ja";
}
const { lang } = Astro.props;

type Row = {
  name: string;
  src: string;
  tz: string;
  days: number[] | null; // 0 = Mon … 6 = Sun; null = not stated
  hours: number[] | null; // active local hours; null = not stated
  fade?: number[]; // hours the report describes as declining
  note: string;
};

const range = (a: number, b: number) => Array.from({ length: b - a }, (_, i) => a + i);

const L = {
  en: {
    title: "Five published working weeks, each in the local time its report inferred",
    days: ["M", "T", "W", "T", "F", "S", "S"],
    dayHead: "days",
    hourHead: "hours, local",
    notStated: "not stated",
    active: "active",
    fade: "declining",
    rows: [
      {
        name: "APT28",
        src: "FireEye 2014, Bitdefender 2015",
        tz: "UTC+4",
        days: range(0, 5),
        hours: range(8, 18),
        note: "an office week",
      },
      {
        name: "APT10",
        src: "PwC and BAE 2017",
        tz: "UTC+8",
        days: null,
        hours: [...range(8, 12), ...range(14, 18)],
        note: "two-hour lunch",
      },
      {
        name: "APT33",
        src: "FireEye 2017",
        tz: "UTC+4:30",
        days: [5, 6, 0, 1, 2],
        hours: null,
        note: "Saturday to Wednesday",
      },
      {
        name: "Equation",
        src: "Kaspersky 2015",
        tz: "UTC−3 or −4",
        days: range(0, 5),
        hours: null,
        note: "workdays; starts 8 or 9",
      },
      {
        name: "Conti",
        src: "Group-IB 2022",
        tz: "GMT+3",
        days: range(0, 7),
        hours: range(12, 21),
        fade: [21, 22, 23, 0, 1],
        note: "14 hours, weekends too",
      },
    ] as Row[],
  },
  ja: {
    title: "公表された 5 つの労働週を、それぞれ報告が推定した現地時刻で描く",
    days: ["月", "火", "水", "木", "金", "土", "日"],
    dayHead: "曜日",
    hourHead: "時刻 (現地)",
    notStated: "記載なし",
    active: "活動",
    fade: "減っていく",
    rows: [
      {
        name: "APT28",
        src: "FireEye 2014、Bitdefender 2015",
        tz: "UTC+4",
        days: range(0, 5),
        hours: range(8, 18),
        note: "オフィスの週",
      },
      {
        name: "APT10",
        src: "PwC・BAE 2017",
        tz: "UTC+8",
        days: null,
        hours: [...range(8, 12), ...range(14, 18)],
        note: "昼休み 2 時間",
      },
      {
        name: "APT33",
        src: "FireEye 2017",
        tz: "UTC+4:30",
        days: [5, 6, 0, 1, 2],
        hours: null,
        note: "土曜から水曜",
      },
      {
        name: "Equation",
        src: "Kaspersky 2015",
        tz: "UTC−3 か −4",
        days: range(0, 5),
        hours: null,
        note: "平日、8 時か 9 時始業",
      },
      {
        name: "Conti",
        src: "Group-IB 2022",
        tz: "GMT+3",
        days: range(0, 7),
        hours: range(12, 21),
        fade: [21, 22, 23, 0, 1],
        note: "1 日 14 時間、週末も",
      },
    ] as Row[],
  },
}[lang];

const dx = 232; // day strip left
const dw = 20; // day cell width
const hx = 388; // hour strip left
const hw = 11.5; // hour cell width
const ch = 18; // cell height
const top = 56;
const rowH = 76;
const H = top + L.rows.length * rowH + 30;
---

<svg class="dg" viewBox={`0 0 680 ${H}`} role="img" aria-labelledby={`bwk-t-${lang}`}>
  <title id={`bwk-t-${lang}`}>{L.title}</title>
  <text x={dx} y="20" class="t-s b">{L.dayHead}</text>
  <text x={hx} y="20" class="t-s b">{L.hourHead}</text>
  {L.days.map((d, i) => (
    <text x={dx + i * dw + dw / 2} y="42" class="t-s t-2" text-anchor="middle">
      {d}
    </text>
  ))}
  {[0, 6, 12, 18, 24].map((h) => (
    <text x={hx + h * hw} y="42" class="mono t-2" text-anchor="middle">
      {String(h).padStart(2, "0")}
    </text>
  ))}
  {
    L.rows.map((r, ri) => {
      const y = top + ri * rowH;
      const gy = y + 6;
      return (
        <g>
          <line x1="12" y1={y - 6} x2="672" y2={y - 6} class="ln-1 soft" />
          <text x="16" y={y + 16} class="b">
            {r.name}
          </text>
          <text x="16" y={y + 34} class="t-s t-2">
            {r.src}
          </text>
          <text x="16" y={y + 52} class="mono">
            {r.tz}
          </text>
          {r.days === null ? (
            <g>
              <rect x={dx} y={gy} width={7 * dw} height={ch} class="ln-1 soft dash" fill="none" />
              <text x={dx + (7 * dw) / 2} y={gy + 13} class="t-s t-2" text-anchor="middle">
                {L.notStated}
              </text>
            </g>
          ) : (
            Array.from({ length: 7 }, (_, d) => (
              <rect
                x={dx + d * dw + 1}
                y={gy + 1}
                width={dw - 2}
                height={ch - 2}
                class={r.days!.includes(d) ? "fill-ink" : "box-soft"}
                opacity={r.days!.includes(d) ? "0.55" : undefined}
              />
            ))
          )}
          {r.hours === null ? (
            <g>
              <rect x={hx} y={gy} width={24 * hw} height={ch} class="ln-1 soft dash" fill="none" />
              <text x={hx + 12 * hw} y={gy + 13} class="t-s t-2" text-anchor="middle">
                {L.notStated}
              </text>
            </g>
          ) : (
            Array.from({ length: 24 }, (_, h) => {
              const on = r.hours!.includes(h);
              const fade = r.fade?.includes(h);
              return on ? (
                <rect x={hx + h * hw + 1} y={gy + 1} width={hw - 2} height={ch - 2} class="fill-ink" opacity="0.55" />
              ) : fade ? (
                <rect x={hx + h * hw + 1.5} y={gy + 1.5} width={hw - 3} height={ch - 3} class="ln-1 dash" fill="none" />
              ) : (
                <rect x={hx + h * hw + 1} y={gy + 1} width={hw - 2} height={ch - 2} class="box-soft" />
              );
            })
          )}
          <text x={dx} y={y + 52} class="t-s b">
            {r.note}
          </text>
        </g>
      );
    })
  }
  <rect x="16" y={H - 20} width="14" height="14" class="fill-ink" opacity="0.55"></rect>
  <text x="36" y={H - 9} class="t-s t-2">{L.active}</text>
  <rect x="110" y={H - 19} width="12" height="12" class="ln-1 dash" fill="none"></rect>
  <text x="128" y={H - 9} class="t-s t-2">{L.fade}</text>
</svg>
