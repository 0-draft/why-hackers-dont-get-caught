---
// The basics pages in reading order. They are a sequence, so they are numbered.
import { getCollection } from "astro:content";
import type { BasicsSlug } from "../data/schema.ts";
import { type Lang, localePath } from "../i18n/ui.ts";

interface Props {
  lang: Lang;
  /** Limit to these pages (layer prerequisites); all published pages otherwise. */
  only?: readonly BasicsSlug[] | undefined;
  compact?: boolean;
}
const { lang, only, compact = false } = Astro.props;
const entries = (await getCollection("basics", (e) => e.id.startsWith(`${lang}/`) && !e.data.draft))
  .filter((e) => !only || only.includes(e.data.basics))
  .toSorted((a, b) => a.data.order - b.data.order);
---

{
  entries.length > 0 && (
    <ol class:list={["bl", { compact }]}>
      {entries.map((e) => (
        <li>
          <a href={localePath(lang, `/basics/${e.data.basics}/`)}>
            <span class="n" aria-hidden="true">
              {e.data.order}
            </span>
            <span class="t">{e.data.title}</span>
            {!compact && <span class="s">{e.data.summary}</span>}
          </a>
        </li>
      ))}
    </ol>
  )
}

<style>
  .bl {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 2px solid var(--ink);
  }
  .bl a {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    gap: 0.15rem 1rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
  }
  .n {
    grid-row: span 2;
    font-family: var(--mono);
    font-size: var(--step-2);
    line-height: 1;
    color: var(--ink-2);
  }
  .t {
    font-weight: 800;
    font-size: var(--step-1);
    font-variation-settings: "wdth" 85;
  }
  .bl a:hover .t {
    text-decoration: underline;
  }
  .s {
    color: var(--ink-2);
    font-size: var(--step--1);
    max-width: 70ch;
  }
  .compact {
    border-top: 0;
  }
  .compact a {
    grid-template-columns: 1.5rem minmax(0, 1fr);
    padding: 0.3rem 0;
    border-bottom: 0;
  }
  .compact .n {
    font-size: var(--step--1);
    grid-row: auto;
  }
  .compact .t {
    font-size: var(--step--1);
    font-weight: 700;
  }
</style>
