---
// A numbered figure. Numbers come from a CSS counter on the article, so en/ja
// stay in step without anyone keeping count by hand.
interface Props {
  caption: string;
  /** "wide" lets the figure break out of the prose measure. */
  size?: "prose" | "wide";
  id?: string;
}
const { caption, size = "prose", id } = Astro.props;
---

<figure class:list={["fig", size]} id={id}>
  <div class="fig-body scroll-x" tabindex="0" role="group" aria-label={caption}>
    <slot />
  </div>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .fig {
    margin: 2.25rem 0;
    counter-increment: fig;
  }
  .fig.wide {
    width: 100%;
  }
  .fig-body {
    background: var(--sheet);
    border: 1.5px solid var(--ink);
    padding: clamp(0.75rem, 0.5rem + 1vw, 1.5rem);
  }
  .fig-body:focus-visible {
    outline-offset: 4px;
  }
  figcaption {
    margin-top: 0.6rem;
    font-size: var(--step--1);
    color: var(--ink-2);
    max-width: 68ch;
  }
  figcaption::before {
    content: "Fig. " counter(fig) "  ";
    font-weight: 700;
    color: var(--ink);
    white-space: pre;
  }
  :global(:lang(ja)) figcaption::before {
    content: "図 " counter(fig) "  ";
  }
</style>
