---
import CaseBoard from "../components/CaseBoard.astro";
import CaseFiles from "../components/CaseFiles.astro";
import Fig from "../components/Fig.astro";
import CaseTimeline from "../components/fig/CaseTimeline.astro";
import { CASES } from "../data/cases.ts";
import { LAYERS } from "../data/layers.ts";
import { type Lang, useT } from "../i18n/ui.ts";
import Base from "../layouts/Base.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
// The timeline caption counts from the data so it cannot drift as cases are added.
const toYear = (d: string) => {
  const [y = 0, m, dd] = d.split("-").map(Number);
  return y + ((m ?? 7) - 1) / 12 + ((dd ?? 15) - 1) / 365;
};
const dated = CASES.flatMap((c) => (c.timeline?.slip ? [toYear(c.timeline.caught) - toYear(c.timeline.slip)] : []));
const timelineCaption = t("cases.timeline")
  .replace("{n}", String(dated.length))
  .replace("{m}", String(dated.filter((g) => g >= 2).length));
---

<Base lang={lang} title={t("cases.title")} description={t("cases.lede")}>
  <div class="wrap page">
    <h1>{t("cases.title")}</h1>
    <p class="lede">{t("cases.lede")}</p>
    <section id="people" class="people">
      <p><strong>{LAYERS.people.name[lang]}</strong> {LAYERS.people.hides[lang]}. {LAYERS.people.breaks[lang]}.</p>
    </section>
    <CaseBoard lang={lang} />
    <CaseFiles lang={lang} />
    <Fig caption={timelineCaption} size="wide">
      <CaseTimeline lang={lang} />
    </Fig>
  </div>
</Base>

<style>
  .page {
    padding-top: 2.5rem;
  }
  .lede {
    max-width: 60ch;
    font-size: var(--step-1);
    line-height: 1.55;
    margin: 1.25rem 0 1.5rem;
  }
  .people {
    max-width: 60ch;
    color: var(--ink-2);
    font-size: var(--step--1);
    margin-bottom: 2.5rem;
  }
  .people strong {
    color: var(--ink);
  }
</style>
