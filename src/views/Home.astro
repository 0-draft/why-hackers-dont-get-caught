---
import { getCollection } from "astro:content";
import BasicsList from "../components/BasicsList.astro";
import CaseBoard from "../components/CaseBoard.astro";
import ReachLedger from "../components/fig/ReachLedger.astro";
import Outcomes from "../components/Outcomes.astro";
import Strata from "../components/Strata.astro";
import Vantage from "../components/Vantage.astro";
import { CASES } from "../data/cases.ts";
import { LAYER_SLUGS, type LayerSlug } from "../data/layers.ts";
import { type Lang, localePath, useT } from "../i18n/ui.ts";
import Base from "../layouts/Base.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const hasBasics = (await getCollection("basics", (e) => !e.data.draft)).length > 0;
const tally: Partial<Record<LayerSlug, number>> = {};
for (const c of CASES)
  if ((LAYER_SLUGS as readonly string[]).includes(c.failed))
    tally[c.failed as LayerSlug] = (tally[c.failed as LayerSlug] ?? 0) + 1;
---

<Base lang={lang}>
  <section class="wrap hero">
    <h1><span>{t("home.h1a")}</span> <span class="b">{t("home.h1b")}</span></h1>
    <p class="lede">{t("home.lede")}</p>
  </section>

  <section class="wrap" aria-labelledby="o-h">
    <h2 id="o-h" class="sec">{t("home.outcomesTitle")}</h2>
    <Outcomes lang={lang} />
  </section>

  <section class="wrap" aria-labelledby="ledger-h">
    <h2 id="ledger-h" class="sec">{t("home.ledgerTitle")}</h2>
    <p class="sec-lede">{t("home.ledgerLede")}</p>
    <div class="ledger">
      <ReachLedger lang={lang} />
    </div>
    <p class="more"><a href={localePath(lang, "/out-of-reach/")}>{t("home.ledgerMore")}</a></p>
  </section>

  <section class="wrap" aria-labelledby="c-h">
    <h2 id="c-h" class="sec">{t("home.casesTitle")}</h2>
    <p class="sec-lede">{t("home.casesLede")}</p>
    <CaseBoard lang={lang} compact />
    <p class="more"><a href={localePath(lang, "/cases/")}>{t("home.casesAll")}</a></p>
  </section>

  <section class="wrap" aria-labelledby="v-h">
    <h2 id="v-h" class="sec">{t("home.vantageTitle")}</h2>
    <Vantage lang={lang} />
  </section>

  <section class="wrap" id="layers" aria-labelledby="l-h">
    <h2 id="l-h" class="sec">{t("home.layersTitle")}</h2>
    <p class="sec-lede">{t("home.layersLede")}</p>
    <Strata lang={lang} tally={tally} />
  </section>

  {
    hasBasics && (
      <section class="wrap" id="basics" aria-labelledby="b-h">
        <h2 id="b-h" class="sec">{t("home.basicsTitle")}</h2>
        <p class="sec-lede">{t("home.basicsLede")}</p>
        <BasicsList lang={lang} compact />
      </section>
    )
  }

</Base>

<style>
  .hero {
    padding-block: clamp(2.5rem, 1rem + 6vw, 6rem) 2.5rem;
  }
  .hero h1 {
    max-width: 30rem;
  }
  .hero h1 .b {
    max-width: 36rem;
  }
  :global(:lang(ja)) .hero h1 {
    max-width: 22em;
    /* break Japanese at phrase boundaries, not inside words */
    word-break: auto-phrase;
  }
  .hero h1 span {
    display: block;
  }
  .hero h1 .b {
    font-size: 0.56em;
    margin-top: 0.45em;
    line-height: 1.12;
    /* The second line is the thesis: the chain gives way. Drawn as a bar
       pulled back to reveal it, the only decorative gesture on the page. */
    position: relative;
    width: fit-content;
  }
  .hero h1 .b::after {
    content: "";
    position: absolute;
    inset: 0.08em -0.1em;
    background: var(--bar);
    box-shadow: 0 0 0 1px var(--bar-edge);
    transform-origin: right center;
    animation: unredact 900ms 300ms cubic-bezier(0.7, 0, 0.2, 1) forwards;
  }
  @keyframes unredact {
    to {
      transform: scaleX(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero h1 .b::after {
      animation: none;
      transform: scaleX(0);
    }
  }
  .lede {
    margin: 2rem 0 0;
    font-size: var(--step-1);
    line-height: 1.55;
    max-width: 52ch;
  }
  :global(:lang(ja)) .lede {
    max-width: 34em;
    line-height: 1.8;
  }
  .sec {
    margin-top: 5rem;
    margin-bottom: 1.25rem;
  }
  .sec-lede {
    margin: -0.5rem 0 1.75rem;
    max-width: 60ch;
    color: var(--ink-2);
  }
  .ledger {
    background: var(--sheet);
    border: 2px solid var(--ink);
    padding: clamp(0.75rem, 0.5rem + 1vw, 1.5rem);
  }
  .more {
    margin-top: 1.25rem;
    font-weight: 700;
  }
</style>
