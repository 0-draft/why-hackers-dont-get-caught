---
import { type CollectionEntry, render } from "astro:content";
import BaseLink from "../components/BaseLink.astro";
import BasicsList from "../components/BasicsList.astro";
import SourceList from "../components/SourceList.astro";
import Strata from "../components/Strata.astro";
import { CASES } from "../data/cases.ts";
import { LAYER_SLUGS, LAYERS } from "../data/layers.ts";
import { SOURCES_BY_PAGE } from "../data/sources.ts";
import { type Lang, localePath, useT } from "../i18n/ui.ts";
import Base from "../layouts/Base.astro";

interface Props {
  lang: Lang;
  entry: CollectionEntry<"layers">;
}
const { lang, entry } = Astro.props;
const t = useT(lang);
const { Content } = await render(entry);
const slug = entry.data.layer;
const meta = LAYERS[slug];
const i = LAYER_SLUGS.indexOf(slug);
const prev = LAYER_SLUGS[i - 1];
const next = LAYER_SLUGS[i + 1];
const failedHere = CASES.filter((c) => c.failed === slug);
const sources = SOURCES_BY_PAGE[slug] ?? [];
---

<Base lang={lang} title={entry.data.title} description={entry.data.summary}>
  <div class="wrap layer-grid">
    <aside class="side">
      <Strata lang={lang} current={slug} compact />
    </aside>
    <article class="layer-article">
      <header class="head">
        <h1>{entry.data.title}</h1>
        <p class="summary">{entry.data.summary}</p>
        <dl class="hb">
          <div>
            <dt>{t("layer.hides")}</dt>
            <dd><span class="bar-inline" aria-hidden="true"></span>{meta.hides[lang]}</dd>
          </div>
          <div>
            <dt>{t("layer.breaks")}</dt>
            <dd><span class="leak-inline" aria-hidden="true"></span>{meta.breaks[lang]}</dd>
          </div>
        </dl>
        {
          entry.data.prereqs && (
            <div class="pre">
              <p class="pre-k">{t("layer.prereqs")}</p>
              <BasicsList lang={lang} only={entry.data.prereqs} compact />
            </div>
          )
        }
      </header>

      <fieldset class="mode">
        <legend class="sr">{t("layer.modeLabel")}</legend>
        <label><input type="radio" name="read-mode" value="short" checked />{t("layer.modeShort")}</label>
        <label><input type="radio" name="read-mode" value="full" />{t("layer.modeFull")}</label>
      </fieldset>

      <div class="prose">
        <Content components={{ a: BaseLink }} />
      </div>

      <section class="cases" aria-labelledby="cases-h">
        <h2 id="cases-h">{t("layer.cases")}</h2>
        {
          failedHere.length === 0 ? (
            <p class="muted">{t("layer.noCases")}</p>
          ) : (
            <ul>
              {failedHere.map((c) => (
                <li>
                  <a href={localePath(lang, `/cases/#${c.id}`)}>
                    <span class="yr">{c.year}</span>
                    <span class="nm">{c.name[lang]}</span>
                    {c.alias && <span class="al">{c.alias[lang]}</span>}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </section>

      {
        sources.length > 0 && (
          <section class="srcs" aria-labelledby="src-h">
            <h2 id="src-h">{t("layer.sources")}</h2>
            <details class="src-fold" data-src-fold>
              <summary>{t("layer.sourcesShow").replace("{n}", String(sources.length))}</summary>
              <SourceList sources={sources} />
            </details>
          </section>
        )
      }

      <nav class="pn" aria-label="Layers">
        {
          prev ? (
            <a href={localePath(lang, `/layers/${prev}/`)} rel="prev">
              <span class="dir">{t("layer.prev")}</span>
              <span class="to">{LAYERS[prev].name[lang]}</span>
            </a>
          ) : (
            <span />
          )
        }
        {
          next && (
            <a href={localePath(lang, `/layers/${next}/`)} rel="next" class="nx">
              <span class="dir">{t("layer.next")}</span>
              <span class="to">{LAYERS[next].name[lang]}</span>
            </a>
          )
        }
      </nav>
    </article>
  </div>
</Base>

<style>
  .mode {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 5;
    display: inline-flex;
    margin: 0 0 1.5rem;
    padding: 0;
    border: 1.5px solid var(--ink);
    background: var(--paper);
  }
  .mode label {
    display: inline-flex;
    align-items: center;
    padding: 0.35rem 0.9rem;
    font-weight: 700;
    font-size: var(--step--1);
    cursor: pointer;
  }
  .mode input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .mode label:has(input:checked) {
    background: var(--ink);
    color: var(--paper);
  }
  .mode label:has(input:focus-visible) {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }
  /* Key-points view. Kept: every heading, the first paragraph under it, every
     figure, the bold lead of each list item, and the closing misconceptions
     whole (a myth without its answer would mislead). Folded: the rest. Same
     nodes in the same order, so "full text" is just these rules switched off. */
  .layer-article:has(input[value="short"]:checked) .prose {
    & > :global(p:not(:first-child):not(h2 + p):not(h2:last-of-type ~ p)) {
      display: none;
    }
    & > :global(ul:not(h2:last-of-type ~ ul):not(:has(> li > strong:first-child))) {
      display: none;
    }
    & > :global(ul:not(h2:last-of-type ~ ul):has(> li > strong:first-child) > li) {
      font-size: 0;
    }
    & > :global(ul:not(h2:last-of-type ~ ul) > li > strong:first-child) {
      font-size: var(--step-0);
    }
    & > :global(ul:not(h2:last-of-type ~ ul) > li > :not(strong:first-child)) {
      display: none;
    }
  }
  .layer-grid {
    display: grid;
    grid-template-columns: 13rem minmax(0, 1fr);
    gap: 3rem;
    padding-top: 2.5rem;
  }
  .side {
    position: sticky;
    top: 1.5rem;
    align-self: start;
  }
  .head {
    max-width: 52rem;
  }
  .summary {
    font-size: var(--step-1);
    line-height: 1.5;
    margin: 1rem 0 0;
    max-width: 48ch;
  }
  :global(:lang(ja)) .summary {
    max-width: 32em;
  }
  .hb {
    margin: 2rem 0 2.5rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem 2rem;
    border-top: 2px solid var(--ink);
    border-bottom: 1px solid var(--rule);
    padding-block: 1rem;
  }
  .hb dt {
    font-size: var(--step--1);
    color: var(--ink-2);
  }
  .hb dd {
    margin: 0.25rem 0 0;
    font-weight: 700;
    display: flex;
    gap: 0.6rem;
    align-items: baseline;
  }
  .bar-inline,
  .leak-inline {
    flex: none;
    width: 1.6rem;
    height: 0.8rem;
    background: var(--bar);
    box-shadow: 0 0 0 1px var(--bar-edge);
  }
  .leak-inline {
    background: var(--leak);
    box-shadow: none;
  }
  .pre {
    margin: -1rem 0 2.5rem;
    display: flex;
    gap: 0.25rem 1.25rem;
    flex-wrap: wrap;
    align-items: baseline;
  }
  .pre-k {
    margin: 0;
    font-size: var(--step--1);
    color: var(--ink-2);
  }
  .cases,
  .srcs {
    margin-top: 4rem;
    max-width: var(--measure);
  }
  .cases h2,
  .srcs h2 {
    font-size: var(--step-2);
    margin-bottom: 1rem;
  }
  .src-fold summary {
    cursor: pointer;
    font-weight: 700;
    color: var(--ink-2);
  }
  .cases ul {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 2px solid var(--ink);
  }
  .cases li a {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    gap: 0 1rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
  }
  .cases li a:hover .nm {
    text-decoration: underline;
  }
  .yr {
    font-family: var(--mono);
    font-size: var(--step--1);
    color: var(--ink-2);
    grid-row: span 2;
    padding-top: 0.15rem;
  }
  .nm {
    font-weight: 700;
  }
  .al {
    color: var(--ink-2);
    font-size: var(--step--1);
  }
  .muted {
    color: var(--ink-2);
  }
  .pn {
    margin-top: 4rem;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    border-top: 2px solid var(--ink);
    padding-top: 1rem;
    max-width: var(--measure);
  }
  .pn a {
    text-decoration: none;
    display: flex;
    flex-direction: column;
  }
  .pn .nx {
    text-align: right;
  }
  .dir {
    font-size: var(--step--1);
    color: var(--ink-2);
  }
  .to {
    font-weight: 800;
    font-size: var(--step-1);
  }
  @media (max-width: 60rem) {
    .layer-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
    }
    .side {
      position: static;
    }
    .hb {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

<script>
  // Sources sit folded at the foot of the chapter. A citation link, or a
  // #src-... address arriving from elsewhere, opens them before the jump.
  const fold = document.querySelector<HTMLDetailsElement>("[data-src-fold]");
  const openFor = (hash: string) => {
    if (fold && hash.startsWith("#src-") && !fold.open) fold.open = true;
  };
  openFor(location.hash);
  if (location.hash.startsWith("#src-")) document.getElementById(location.hash.slice(1))?.scrollIntoView();
  document.addEventListener("click", (e) => {
    const a = (e.target as Element | null)?.closest?.("a[href^='#src-']");
    if (a) openFor(a.getAttribute("href") ?? "");
  });
  window.addEventListener("hashchange", () => openFor(location.hash));
</script>
